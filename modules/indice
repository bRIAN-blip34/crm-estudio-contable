  // ── TABS (secciones del cliente, elegidas desde el rail) ───────
  async function switchTabById(id) {
    if (!clienteActivo) return;
    marcarRailActivo(id);
    document.querySelectorAll('.tab-content').forEach(c => c.classList.toggle('active', c.id === 'tab-' + id));
    // Hide global admin panels when switching to client tabs
    ocultarPanelesGlobales();
    if (id === 'inicio' && clienteActivo) {
      const { renderDashboard } = await import('./modules/clientes/dashboard.js?v=' + window._appVersion);
      await renderDashboard(
        document.getElementById('tab-inicio'),
        clienteActivo.id,
        clienteActivo,
        window._db
      );
