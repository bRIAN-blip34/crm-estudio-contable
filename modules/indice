  function urlCrm(extra = '') {
    const base = enFinnix ? CRM_URL : location.origin + '/';
    return base + (extra ? '?' + extra : '');
  }

  // ── UI helpers ───────────────────────────────────────────────
  // Prefijo profesional del saludo — "Cr." (Contador) solo tiene sentido
  // para el rol contador; admin/administrativo van sin prefijo.
  const PREFIJO_ROL = { contador: 'Cr. ' };

  async function mostrarApp(user) {
    // Este CRM comparte proyecto Firebase con finnix-app/urban.os/
    // minimarket.os (ver CLAUDE.md, "Stack") — Firebase Auth autentica
    // contra el proyecto entero, no por app, así que la cuenta de un
    // cliente o de un titular de comercio .OS TAMBIÉN puede loguearse acá
    // con éxito. Lo único que distingue a alguien del personal del
    // estudio es tener un doc en /crm_users/{uid} — sin chequearlo antes
    // de mostrar nada, la app seguía adelante con miRol=null y recién
    // fallaba después al pedir /clientes/ (permission-denied de
    // Firestore, visto como "No se pudieron cargar los clientes" — un
    // error confuso, no un rechazo real). Ahora se corta ACÁ: sin doc, o
    // con `activo:false` (cuenta desactivada desde "Usuarios" — antes ese
    // campo no se llegaba a chequear en ningún lado del login, así que
    // desactivar a alguien no le impedía seguir entrando), se cierra la
    // sesión al toque y se avisa, antes de mostrar un solo dato del CRM.
    let snap;
    try {
      snap = await window._getDoc(window._doc(window._db, 'crm_users', user.uid));
    } catch (e) {
      console.error('Error al obtener el rol del usuario:', e);
      await window._signOut(window._auth);
      window._toast('No se pudo verificar el acceso a esta cuenta. Probá de nuevo.', 'error');
      return false;
    }
    if (!snap.exists() || snap.data().activo === false) {
      await window._signOut(window._auth);
      window._toast('Esta cuenta no tiene acceso al CRM de Finnix.', 'error');
      return false;
    }

    document.getElementById('auth-screen').style.display = 'none';
    const app = document.getElementById('app');
    app.classList.add('visible');
    document.getElementById('topbar-email').textContent = user.email;

    const miNombre = snap.data().nombre || null;
    window._miNombre = miNombre;
    miRol = snap.data().rol;
    window._estudioId = snap.data().estudio_id || ESTUDIO_ID_DEFAULT;
    document.getElementById('btn-usuarios').style.display =
      (miRol === 'admin' || miRol === 'super_admin') ? '' : 'none';
    const btnNegocio = document.getElementById('btn-ir-negocio');
    btnNegocio.style.display = (!MODO_NEGOCIO && esDuenoFinnix()) ? '' : 'none';
    btnNegocio.href = urlNegocio();
    // Campanita con los avisos propios (13/10/2026).
    import('./modules/admin/campanita.js?v=' + window._appVersion)
      .then(({ initCampanita }) => initCampanita({ db: window._db, uid: user.uid, modoNegocio: MODO_NEGOCIO }))
      .catch((e) => console.error('campanita', e));
    // Papelera de clientes: mismo criterio que "Eliminar" en la tabla de
    // roles (admin/super_admin). Si estaba en modo papelera de una sesión
    // anterior (no debería, pero por las dudas) la resetea al entrar.
    verPapelera = false;
    document.getElementById('btn-papelera').style.display =
      (miRol === 'admin' || miRol === 'super_admin') ? '' : 'none';
    document.getElementById('topbar-saludo').textContent =
      miNombre ? `Hola, ${PREFIJO_ROL[miRol] || ''}${miNombre}` : '';

    await cargarEstudio();

    // super_admin (equipo Finnix, no de un estudio puntual — ver
    // CLAUDE.md "Multi-tenant"): selector de estudio en el topbar, además
    // del resto de la app (todavía scopeada a window._estudioId, que acá
    // arranca en ESTUDIO_ID_DEFAULT igual que cualquiera sin estudio_id
    // propio — el selector deja cambiarlo después), y botón para dar de
    // alta un estudio nuevo (modules/admin/alta-estudio.js).
    document.getElementById('btn-nuevo-estudio').style.display =
      miRol === 'super_admin' ? '' : 'none';
    if (miRol === 'super_admin') {
      await cargarSelectorEstudiosSuperAdmin();
    }

    // Panel de inicio con KPIs: antes solo admin/contador, ahora también
    // super_admin (misma vista "global" que ve un admin, para el estudio
    // elegido en el selector de arriba).
    dashboardDisponible = miRol === 'admin' || miRol === 'contador' || miRol === 'super_admin';
    if (MODO_NEGOCIO) prepararModoNegocio();
    if (dashboardDisponible && !MODO_NEGOCIO) {
      document.getElementById('empty-state').style.display = 'none';
      const wrap = document.getElementById('admin-dashboard-wrap');
      // Se arma de fondo y queda oculto: se abre desde la tarjeta "Panel de
      // administrador" de Secciones, a pantalla completa (12/10/2026).
      wrap.style.display = 'none';
      const { renderDashboardGeneral } = await import('./modules/admin/dashboard-general.js?v=' + window._appVersion);
      await renderDashboardGeneral(wrap, window._db, miRol === 'contador' ? user.uid : null);
      // Quien maneja un solo mundo (contador) entra derecho al Panel
      // principal — un admin/super_admin (dueño) pasa por irMundos() más
      // abajo, que ya deja este mismo estado (rail/sidebar/breadcrumb
      // ocultos, secciones-estudio-wrap mostrado) sin duplicar el trabajo acá.
      if (!esDuenoDelNegocio()) {
        const seccionesWrap = document.getElementById('secciones-estudio-wrap');
        seccionesWrap.style.display = '';
        const { renderSeccionesEstudio } = await import('./modules/admin/secciones-estudio.js?v=' + window._appVersion);
        renderSeccionesEstudio(seccionesWrap, {
          rol: miRol, dueno: false, puedeLaboral: puedeVerRecursosLaborales(),
        });
        toggleSidebarGlobal(false);
        mostrarBreadcrumb(false);
        toggleRail(false);
      }
    }
    // Enlaces de Onboarding/Clientes Pendientes/Verificación/Monotributo/
    // DDJJ/Seguimiento/Recursos Laborales ya no son botones del rail
    // (25/09/2026, ver el comentario largo en el HTML del rail más arriba)
    // — quién ve cada tarjeta de "Secciones" lo decide
    // modules/admin/secciones-estudio.js con los mismos criterios que
    // regían acá (dashboardDisponible / esDuenoDelNegocio() / mismo tab
    // "Plan Finnix" sin cambios / puedeVerRecursosLaborales()), no hace
    // falta repetirlos en dos lugares.

    // Al loguearse (o recargar la página), quien maneja más de un mundo
    // entra al índice que los agrupa en vez de caer directo en el
    // dashboard fiscal — ver modules/admin/mundos.js. Se llama al final,
    // después de que el dashboard del estudio ya terminó de cargar
    // (arriba, dashboardDisponible) — así queda listo de fondo, sin volver
    // a pedirlo, para cuando el propio índice lleve a "Estudio contable".
    // Un contador (un solo mundo) no pasa por acá — sigue entrando
    // derecho al dashboard de siempre, mismo comportamiento que ya tenía.
    if (MODO_NEGOCIO) {
      // Panel del negocio: solo admin/super_admin. El resto ve un aviso con
      // el link al CRM del estudio (ver prepararModoNegocio).
      if (esDuenoFinnix()) await irSuscripciones();
    } else if (esDuenoDelNegocio()) {
      // Se espera: un link ?cliente= abre la ficha después (abrirDeepLink) y
      // no tiene que pisarla el Panel principal.
      await irInicio();
    } else if (!dashboardDisponible && puedeVerRecursosLaborales()) {
      // Rol "laboral" puro (no admin/super_admin, esos ya son
      // dashboardDisponible) — su ÚNICO destino en todo el CRM es Recursos
      // Laborales (ver CLAUDE.md, ese rol no tiene panel de inicio ni
      // cartera de clientes). Hasta el 24/09/2026 llegaba ahí clickeando
      // el único ítem del rail que le quedaba visible; sin esos botones
      // (ver el comentario largo en el HTML del rail) lo lleva directo,
      // en vez de dejarlo en el empty-state sin ningún camino hacia adelante.
      irRecursosLaborales();
    }
    await mostrarPruebaEstudio(snap.data());
    return true;
  }

  // Estudio en prueba (26/10/2026, modules/admin/estudio-prueba.js): barra con
  // los días que quedan, pantalla de "terminó tu prueba" y, la primera vez que
  // entra la contadora, el recorrido guiado (modules/admin/recorrido.js).
  window._abrirGuias = async (id) => {
    const { abrirGuias } = await import('./modules/admin/guias-finnix.js?v=' + window._appVersion);
    abrirGuias(id);
  };
  window._abrirRecomendarEstudio = async () => {
    const { abrirRecomendar } = await import('./modules/admin/estudio-prueba.js?v=' + window._appVersion);
    abrirRecomendar();
  };
  async function mostrarPruebaEstudio(yo) {
    document.getElementById('ep-barra')?.remove();
    const e = window._estudio;
    if (!e || e.id === ESTUDIO_ID_DEFAULT || !(e.tipo === 'prueba' || ['vencida', 'pausada'].includes(e.estado))) return;
    try {
      const { aplicarEstadoEstudio } = await import('./modules/admin/estudio-prueba.js?v=' + window._appVersion);
      aplicarEstadoEstudio({ estudio: e, rol: miRol, nombre: window._miNombre, signOut: () => window._signOut(window._auth) });
      const uid = window._auth.currentUser?.uid;
      window._iniciarRecorrido = async () => {
        const { iniciarRecorrido } = await import('./modules/admin/recorrido.js?v=' + window._appVersion);
        iniciarRecorrido({ db: window._db, uid });
      };
      if (yo?.recorrido_pendiente && miRol === 'admin' && e.estado === 'prueba' && !MODO_NEGOCIO) {
        setTimeout(() => window._iniciarRecorrido(), 600);
      }
    } catch (err) {
      console.error('No se pudo mostrar la prueba del estudio:', err);
    }
  }

  // Selector de estudio del topbar — solo super_admin. Puebla desde
  // /estudios/ (la regla le permite listar TODOS, sin where, ver
  // firestore.rules función esSuperAdmin()) y deja elegido el estudio
  // actual (window._estudioId, default ESTUDIO_ID_DEFAULT al loguear).
  async function cargarSelectorEstudiosSuperAdmin() {
    const sel = document.getElementById('topbar-estudio-select');
    sel.style.display = '';
    try {
      const snap = await window._getDocs(window._collection(window._db, 'estudios'));
      const estudios = snap.docs
        .map(d => ({ id: d.id, nombre: d.data().nombre || d.id }))
        .sort((a, b) => a.nombre.localeCompare(b.nombre));
      sel.innerHTML = estudios
        .map(e => `<option value="${e.id}" ${e.id === window._estudioId ? 'selected' : ''}>${e.nombre}</option>`)
        .join('');
    } catch (e) {
      console.error('Error al cargar el selector de estudios:', e);
    }
  }
  window._cargarSelectorEstudiosSuperAdmin = cargarSelectorEstudiosSuperAdmin;

  // Cambia el estudio que super_admin está viendo/gestionando — recarga
  // todo lo que depende de window._estudioId (co-branding, sidebar de
  // clientes, panel de inicio), sin recargar la página ni tocar la sesión
  // de Firebase Auth (sigue siendo el mismo usuario, cambia el contexto).
  async function cambiarEstudioSuperAdmin(nuevoEstudioId) {
    window._estudioId = nuevoEstudioId;
    clienteActivo = null;
    cerrarSidebarMobile();
    document.getElementById('cliente-panel').classList.remove('visible');
    await cargarEstudio();
    await mostrarPruebaEstudio(null);
    await cargarClientes();
    ocultarPanelesGlobales();
    if (dashboardDisponible) {
      const wrap = document.getElementById('admin-dashboard-wrap');
      document.getElementById('empty-state').style.display = 'none';
      wrap.style.display = 'none';
      const { renderDashboardGeneral } = await import('./modules/admin/dashboard-general.js?v=' + window._appVersion);
      await renderDashboardGeneral(wrap, window._db, null);
      const seccionesWrap = document.getElementById('secciones-estudio-wrap');
      seccionesWrap.style.display = '';
      const { renderSeccionesEstudio } = await import('./modules/admin/secciones-estudio.js?v=' + window._appVersion);
      renderSeccionesEstudio(seccionesWrap, {
        rol: miRol,
        dueno: esDuenoFinnix(),
        estudioFinnix: (window._estudioId || ESTUDIO_ID_DEFAULT) === 'insfran',
        puedeLaboral: puedeVerRecursosLaborales(),
      });
    }
    toggleSidebarGlobal(false);
    mostrarBreadcrumb(false);
    toggleRail(false);
    marcarRailActivo(null);
    actualizarRailDisponibilidad(false);
  }
  window._cambiarEstudioSuperAdmin = cambiarEstudioSuperAdmin;

  // "Inicio" del rail: deselecciona el cliente activo y muestra el panel
  // de KPIs (admin/contador) o el empty-state de siempre. Sin cambios
  // desde que existe — sigue siendo la vuelta rápida al dashboard del
  // estudio mientras se está trabajando, no al índice de mundos de abajo
  // (ese es otro botón, el logo de la topbar — ver irLogo()).
  async function irInicio() {
    clienteActivo = null;
    cerrarSidebarMobile();
    filtrarClientes();
    document.getElementById('cliente-panel').classList.remove('visible');
    ocultarPanelesGlobales();
    if (dashboardDisponible) {
      document.getElementById('empty-state').style.display        = 'none';
      document.getElementById('admin-dashboard-wrap').style.display = 'none';
      const seccionesWrap = document.getElementById('secciones-estudio-wrap');
      seccionesWrap.style.display = '';
      const { renderSeccionesEstudio } = await import('./modules/admin/secciones-estudio.js?v=' + window._appVersion);
      renderSeccionesEstudio(seccionesWrap, {
        rol: miRol,
        dueno: esDuenoFinnix(),
        estudioFinnix: (window._estudioId || ESTUDIO_ID_DEFAULT) === 'insfran',
        puedeLaboral: puedeVerRecursosLaborales(),
      });
    } else {
      document.getElementById('admin-dashboard-wrap').style.display = 'none';
      document.getElementById('secciones-estudio-wrap').style.display = 'none';
      document.getElementById('empty-state').style.display          = '';
    }
    toggleSidebarGlobal(false);
    mostrarBreadcrumb(false);
    toggleRail(false);
    marcarRailActivo(null);
    actualizarRailDisponibilidad(false);
  }
  window.irInicio = irInicio;

  // Panel de administrador a pantalla completa (12/10/2026): antes iba
  // debajo de las Secciones y se mezclaba con ellas; ahora es una tarjeta
  // más. El módulo ya está armado desde el login (admin-dashboard-wrap),
  // acá solo se muestra solo, con "← Panel principal" para volver.
  function irPanelAdmin() {
    if (!dashboardDisponible) return;
    clienteActivo = null;
    cerrarSidebarMobile();
    document.getElementById('cliente-panel').classList.remove('visible');
    ocultarPanelesGlobales();
    document.getElementById('empty-state').style.display = 'none';
    document.getElementById('secciones-estudio-wrap').style.display = 'none';
    document.getElementById('admin-dashboard-wrap').style.display = '';
    toggleRail(false);
    toggleSidebarGlobal(false);
    mostrarBreadcrumb(true);
    marcarRailActivo(null);
    actualizarRailDisponibilidad(false);
    document.querySelector('.main-panel')?.scrollTo?.(0, 0);
  }
  window.irPanelAdmin = irPanelAdmin;

  // Índice de mundos (24/09/2026, modules/admin/mundos.js) — punto de
  // entrada nuevo para quien maneja más de un mundo (admin/super_admin):
  // tres tarjetas (Estudio contable / Finnix / .OS) que llevan a lo que ya
  // existía sin tocarlo (irInicio/irSuscripciones/irOnboardingComercio).
  // Un contador nunca la ve — un solo mundo no necesita elegir nada.
  async function irMundos() {
    // Desde el 13/10/2026 cada panel tiene su dirección: el índice de mundos
    // ya no se muestra (mundos.js queda sin uso).
    if (MODO_NEGOCIO) { irSuscripciones(); return; }
    irInicio(); return;
    if (!esDuenoDelNegocio()) { irInicio(); return; }
    clienteActivo = null;
    cerrarSidebarMobile();
    filtrarClientes();
    document.getElementById('cliente-panel').classList.remove('visible');
    document.getElementById('empty-state').style.display          = 'none';
    document.getElementById('admin-dashboard-wrap').style.display = 'none';
    document.getElementById('secciones-estudio-wrap').style.display = 'none';
    ocultarPanelesGlobales('mundos-panel-wrap');
    const wrap = document.getElementById('mundos-panel-wrap');
    wrap.style.display = '';
    toggleRail(false);
    toggleSidebarGlobal(false);
    mostrarBreadcrumb(false);
    marcarRailActivo(null);
    actualizarRailDisponibilidad(false);
    const { renderMundos } = await import('./modules/admin/mundos.js?v=' + window._appVersion);
    renderMundos(wrap);
  }
  window.irMundos = irMundos;

  // Logo de la topbar — antes iba directo a irInicio() (el dashboard del
  // estudio); ahora, para quien maneja más de un mundo, abre el índice de
  // arriba. Un contador (un solo mundo) sigue yendo directo al dashboard
  // de siempre, sin este paso de más — mismo criterio en todo este cambio:
  // "los contadores no entienden de tecnología, no les complico el flujo".
  function irLogo() {
    if (MODO_NEGOCIO) irSuscripciones(); else irInicio();
  }
  window.irLogo = irLogo;

  // Barra y textos propios del panel del negocio (13/10/2026).
  function prepararModoNegocio() {
    document.getElementById('topbar-studio-name').textContent = 'Finnix — mi negocio';
    document.querySelector('.topbar-studio-sub').textContent = 'Sistemas, suscripciones y .OS';
    document.getElementById('topbar-studio-badge').textContent = 'Fx';
    const nav = document.getElementById('negocio-nav');
    const estudio = document.getElementById('negocio-ir-estudio');
    if (estudio) estudio.href = urlCrm();
    if (!esDuenoFinnix()) {
      if (nav) nav.hidden = true;
      const vacio = document.getElementById('empty-state');
      vacio.style.display = '';
      vacio.innerHTML = '<div class="negocio-sin-acceso"><h2>Este panel es de la administración de Finnix</h2>' +
        '<p>Tu trabajo del estudio está en el CRM.</p><a class="fx-btn-primary" href="' + urlCrm() + '">Ir al CRM del estudio</a></div>';
      return;
    }
    if (nav) nav.hidden = false;
  }
  function marcarNegocioNav(cual) {
    document.querySelectorAll('[data-negocio-nav]').forEach((b) => {
      b.classList.toggle('activo', b.dataset.negocioNav === cual);
    });
  }
  window.marcarNegocioNav = marcarNegocioNav;

  // Links que llegan desde el otro panel: ?cliente=ID (CRM) abre la ficha,
  // ?gestionar=ID (negocio) abre el plan, ?tab=… una pestaña de Finnix, ?os el
  // panel .OS. Se llama una vez, con los clientes ya cargados.
  async function abrirDeepLink() {
    const cliente = PARAMS_INICIO.get('cliente');
    const gestionar = PARAMS_INICIO.get('gestionar');
    const tab = PARAMS_INICIO.get('tab');
    try {
      if (!MODO_NEGOCIO && cliente) await seleccionarCliente(cliente);
      else if (MODO_NEGOCIO && esDuenoFinnix() && gestionar) { await irSuscripciones('clientes'); window._spGestionar?.(gestionar); }
      else if (MODO_NEGOCIO && esDuenoFinnix() && PARAMS_INICIO.has('os')) await irOnboardingComercio();
      else if (MODO_NEGOCIO && esDuenoFinnix() && tab) await irSuscripciones(tab);
    } catch (e) { console.error('abrirDeepLink', e); }
  }
  window._abrirDeepLink = abrirDeepLink;

  // Segundo ítem global del rail — panel de la cartera del pivote de venta
  // directa (plan_id/plan_estado/suscripciones), separado del panel de
  // Inicio de arriba (que es honorarios/comunicaciones del modelo viejo).
  // Mismo criterio de acceso que dashboardDisponible. Se re-renderiza
  // entero en cada visita (sin caché) — mismo criterio que switchTabById
  // con las tabs del cliente.
  // Los paneles globales del rail (Suscripciones, onboarding, verificación,
  // monotributo) son excluyentes entre sí y con la ficha del cliente. Antes
  // cada ir*() listaba a mano los otros wraps para esconderlos, así que
  // agregar un panel nuevo obligaba a acordarse de sumarlo en 8 lugares — y
  // olvidarse de uno deja dos paneles superpuestos sin ningún error.
  const PANELES_GLOBALES = [
    'mundos-panel-wrap',
    'suscripciones-panel-wrap',
    'onboarding-links-panel-wrap',
    'onboarding-clientes-panel-wrap',
    'onboarding-comercio-panel-wrap',
    'verificacion-panel-wrap',
    'monotributo-panel-wrap',
    'ddjj-panel-wrap',
    'seguimiento-panel-wrap',
    'tareas-panel-wrap',
    'laboral-panel-wrap',
    'notificaciones-panel-wrap',
    'altas-clientes-panel-wrap',
    'contactos-web-panel-wrap',
  ];
  function ocultarPanelesGlobales(excepto) {
    PANELES_GLOBALES.forEach((id) => {
      if (id === excepto) return;
      const el = document.getElementById(id);
      if (el) el.style.display = 'none';
    });
  }

  // Muestra/oculta el rail entero (24/09/2026) — Finnix y .OS son, hoy,
  // pantallas únicas sin sub-navegación propia: un rail ahí solo mostraría
  // un ícono para "volver", que ya cumple el botón "← Volver al índice" del
  // panel. Se oculta al entrar a esos dos mundos y al índice mismo (nada
  // elegido todavía) y se muestra de nuevo al entrar a Estudio, que sí
  // tiene varias pantallas y necesita el rail para moverse entre ellas.
  function toggleRail(visible) {
    const rail = document.getElementById('rail');
    if (rail) rail.style.display = visible ? '' : 'none';
  }

  // Muestra/oculta el sidebar de clientes (25/09/2026) — antes era siempre
  // visible, sin importar la pantalla; ahora solo tiene sentido dentro de
  // la sección "Clientes" (irClientes()) o con la ficha de un cliente
  // abierta (seleccionarCliente()). Clase CSS propia (sidebar-oculta), no
  // is-sidebar-collapsed — esa es la preferencia manual del usuario (botón
  // ‹›) y no hay que pisarla con esto.
  function toggleSidebarGlobal(visible) {
    document.querySelector('.main-layout').classList.toggle('sidebar-oculta', !visible);
  }

  // Breadcrumb "← Panel principal" — reemplaza al rail en toda sección del
  // estudio que no sea la ficha de un cliente (ver toggleRail() arriba).
  function mostrarBreadcrumb(visible) {
    document.getElementById('panel-breadcrumb').style.display = visible ? 'flex' : 'none';
  }

  // tab (opcional, 07/10/2026): abre el panel en una pestaña puntual
  // ('uso', 'comunicacion', 'altas'...) — lo usa el buscador Ctrl+K.
  async function irSuscripciones(tab) {
    if (!esDuenoFinnix()) return;
    if (!MODO_NEGOCIO) { window.open(urlNegocio(tab ? 'tab=' + tab : ''), '_blank', 'noopener'); return; }
    marcarNegocioNav('finnix');
    clienteActivo = null;
    cerrarSidebarMobile();
    filtrarClientes();
    document.getElementById('cliente-panel').classList.remove('visible');
    document.getElementById('empty-state').style.display          = 'none';
    document.getElementById('admin-dashboard-wrap').style.display = 'none';
    document.getElementById('secciones-estudio-wrap').style.display = 'none';
    ocultarPanelesGlobales('suscripciones-panel-wrap');
    const wrap = document.getElementById('suscripciones-panel-wrap');
    wrap.style.display = '';
    toggleRail(false);
    toggleSidebarGlobal(false);
    mostrarBreadcrumb(false);
