  // En mobile el sidebar es un cajón superpuesto (oculto por default),
  // no una columna que empuja el layout — mismo botón/función de
  // siempre, pero alterna una clase distinta (mobile-sidebar-open) según
  // el ancho de pantalla (ver CSS @media). matchMedia se evalúa en cada
  // click a propósito, no una sola vez al cargar, para que rotar el celu
  // o redimensionar la ventana no deje la función usando la rama vieja.
  function toggleSidebar() {
    const layout = document.querySelector('.main-layout');
    const icon   = document.getElementById('sidebar-toggle-icon');
    if (window.matchMedia('(max-width: 768px)').matches) {
      const abierto = layout.classList.toggle('mobile-sidebar-open');
      icon.textContent = abierto ? '✕' : '☰';
    } else {
      const colapsado = layout.classList.toggle('is-sidebar-collapsed');
      icon.textContent = colapsado ? '›' : '‹';
    }
  }

  function cerrarSidebarMobile() {
    document.querySelector('.main-layout').classList.remove('mobile-sidebar-open');
    const icon = document.getElementById('sidebar-toggle-icon');
    if (window.matchMedia('(max-width: 768px)').matches) icon.textContent = '☰';
