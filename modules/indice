  window.mostrarApp       = mostrarApp;
  window.cargarClientes   = cargarClientes;
  // "¿Olvidaste tu contraseña?" — hasta ahora, un contador que se olvidaba
  // la clave dependía de que un admin se la reseteara (y por lo tanto la
  // conociera). Firebase manda su propia plantilla de mail; no hace falta
  // servidor de correo. No revela si el email existe o no: contesta lo
  // mismo en los dos casos, para no volverlo un verificador de cuentas.
  async function recuperarContrasena() {
    const email = document.getElementById('login-email').value.trim();
    const err   = document.getElementById('auth-error');
    if (!email) { err.textContent = 'Escribí tu email arriba y volvé a tocar el link.'; return; }

    const btn = document.getElementById('btn-olvide');
    btn.disabled = true;
    btn.textContent = 'Enviando…';
    try {
      await window._sendPasswordResetEmail(window._auth, email);
    } catch (e) {
      // user-not-found se traga a propósito (ver arriba); el resto se avisa.
      const c = String(e.code || '');
      if (!c.includes('user-not-found')) {
        console.error('Error enviando el mail de recuperación:', e);
        err.textContent = c.includes('invalid-email') ? 'Ese email no es válido.'
          : c.includes('too-many-requests') ? 'Demasiados intentos seguidos, esperá unos minutos.'
          : 'No se pudo enviar el mail. Probá de nuevo en un rato.';
        btn.disabled = false;
        btn.textContent = '¿Olvidaste tu contraseña?';
        return;
      }
    }
    err.textContent = '';
    btn.textContent = '✓ Si esa cuenta existe, te llegó un mail';
  }
  window.recuperarContrasena = recuperarContrasena;

  window.handleLogin      = handleLogin;
