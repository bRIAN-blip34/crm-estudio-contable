  // cero queries nuevas acá; antes esto era 1 query por cliente en cada
  // carga del CRM, ver CLAUDE.md "Rendimiento a escala"). Alimenta el
  // punto rojo del sidebar y de la tab Consultas — antes no había ningún
  // aviso acá, solo se veía si entrabas al tab de ese cliente puntual.
  let consultasSinLeer = new Map();

  // Multi-tenant fase 2 (ver CLAUDE.md) — slug del único estudio que
  // existía antes de este campo. Fallback cuando un crm_user todavía no
  // tiene estudio_id seteado (mismo default que usan las reglas).
  const ESTUDIO_ID_DEFAULT = 'insfran';

  // ── DOS PANELES, UN SOLO CRM (13/10/2026) ────────────────────
  // Pedido de Aleja: separar el estudio de su negocio. Misma base, mismo
  // usuario y mismo rol; lo que cambia es la dirección:
  //   · crm.finnix.com.ar → solo el estudio (clientes, tareas, impuestos...).
  //   · negocio.finnix.com.ar → solo Finnix — mi negocio y .OS (admin y
  //     super_admin). "?negocio" en cualquier dirección del CRM abre el mismo
  //     modo: sirve de respaldo mientras el dominio nuevo no esté configurado.
  // Los links que cruzan de un panel al otro abren la otra dirección
  // (?cliente=ID abre una ficha en el CRM, ?gestionar=ID el plan en negocio).
  const CRM_URL = 'https://crm.finnix.com.ar/';
  const NEGOCIO_URL = 'https://negocio.finnix.com.ar/';
  const PARAMS_INICIO = new URLSearchParams(location.search);
  const MODO_NEGOCIO = location.hostname.startsWith('negocio.') || PARAMS_INICIO.has('negocio');
  window._modoNegocio = MODO_NEGOCIO;
  if (MODO_NEGOCIO) {
    document.documentElement.classList.add('modo-negocio');
    document.title = 'Finnix — mi negocio';
  }
  // Hasta que negocio.finnix.com.ar esté configurado (Vercel, dominio
  // autorizado de Firebase Auth y clave de reCAPTCHA), los links al panel del
  // negocio usan "?negocio" sobre el mismo CRM. Al confirmarlo, pasar a true.
  const NEGOCIO_DOMINIO_ACTIVO = true;
  const enFinnix = location.hostname.endsWith('finnix.com.ar');
  function urlNegocio(extra = '') {
    if (enFinnix && NEGOCIO_DOMINIO_ACTIVO) return NEGOCIO_URL + (extra ? '?' + extra : '');
    const base = enFinnix ? CRM_URL : location.origin + '/';
    return base + '?negocio' + (extra ? '&' + extra : '');
