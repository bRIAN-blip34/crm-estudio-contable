  import { getMessaging, isSupported, getToken } from 'https://www.gstatic.com/firebasejs/10.12.2/firebase-messaging.js';

  // Cache-busting para los módulos dinámicos: sin esto, Vercel (edge
  // cache) y el navegador pueden seguir sirviendo una versión vieja de
  // un módulo después de un deploy — no hay hash de contenido en el
  // nombre del archivo como en un build con bundler. Bump manual acá
  // cada vez que se despliega un cambio en algún módulo. Expuesto en
  // window porque los import() dinámicos que la usan viven en el otro
  // <script> (plano, no module — scope separado de este).
  window._appVersion = '2026-10-27-5';

  // ── CONFIG — reemplazá con tus credenciales Firebase ────────
  const firebaseConfig = {
    apiKey:            "AIzaSyCgpZnHLfdoMu3YuCvQvJUnVWONpI3g2LU",
    authDomain:        "finnix-crm.firebaseapp.com",
    projectId:         "finnix-crm",
    storageBucket:     "finnix-crm.firebasestorage.app",
    messagingSenderId: "869108301178",
    appId:             "1:869108301178:web:678d8cf5ce0f9a71286ac3"
  };

  const app     = initializeApp(firebaseConfig);

  // ── APP CHECK ───────────────────────────────────────────────
  // Prueba que el pedido viene de ESTA app y no de un script cualquiera con
  // la apiKey (que es pública por diseño: lo que protege los datos son las
  // reglas, no la clave). Sin App Check, cualquiera puede hablarle a las
  // Cloud Functions públicas desde curl.
  //
  // Clave cargada el 23/09/2026 — la consola de Firebase ya no ofrece
  // reCAPTCHA v3 "clásico" como proveedor, solo reCAPTCHA Enterprise (la
  // clave se generó en Google Cloud Console → Security → reCAPTCHA
  // Enterprise, no en el flujo inline que existía antes). Por eso el
  // proveedor del SDK es ReCaptchaEnterpriseProvider, no ReCaptchaV3Provider
  // — mismo mecanismo de fondo (invisible, por puntaje), otra clase.
  //
  // ⚠ La EXIGENCIA sigue apagada en la consola de Firebase — con la clave
  // cargada, los pedidos YA viajan con token, pero todavía no se rechaza a
  // nadie sin uno. Ver CLAUDE.md, "App Check", para el resto del orden de
  // activación — hay 4 apps sobre este mismo proyecto (este CRM, finnix-app,
  // urban.os y minimarket.os) y encender la exigencia antes de que TODAS
  // manden token deja afuera a las que falten.
  const APPCHECK_SITE_KEY = '6LfDyMstAAAAAFVbcyWCBYDG0FR9T-2q9LQxM6r-';

  if (APPCHECK_SITE_KEY) {
    try {
      const { initializeAppCheck, ReCaptchaEnterpriseProvider } =
        await import('https://www.gstatic.com/firebasejs/10.12.2/firebase-app-check.js');
      initializeAppCheck(app, {
        provider: new ReCaptchaEnterpriseProvider(APPCHECK_SITE_KEY),
        isTokenAutoRefreshEnabled: true,
      });
    } catch (e) {
      // Que App Check no cargue no puede dejar sin CRM al estudio: mientras
      // la exigencia esté apagada en la consola, los pedidos pasan igual.
      console.error('App Check no pudo inicializarse:', e);
    }
  }

  const auth    = getAuth(app);
  const db      = getFirestore(app);
  const storage = getStorage(app);
  // Misma región que las Cloud Functions (ver functions/lib/*.js,
  // REGION = 'southamerica-east1') — si no coinciden, httpsCallable no
  // encuentra la function y tira 404/CORS.
  const functionsInstance = getFunctions(app, 'southamerica-east1');

  // Exponemos al scope global para los onclick inline
  window._auth    = auth;
  window._db      = db;
  window._storage = storage;
  window._functions = functionsInstance;
  window._httpsCallable = httpsCallable;
  window._fbApiKey = firebaseConfig.apiKey;
  window._signInWithEmailAndPassword = signInWithEmailAndPassword;
  // El login vive en el <script> plano de más abajo, sin imports propios.
  window._sendPasswordResetEmail = sendPasswordResetEmail;
  window._signOut = signOut;
  window._collection = collection;
  window._getDocs = getDocs;
  window._query = query;
  window._orderBy = orderBy;
  window._where = where;
  window._doc = doc;
  window._getDoc = getDoc;
  window._setDoc = setDoc;

  // Verificación en dos pasos (SMS) — ver "Seguridad de las cuentas" en
  // CLAUDE.md. RecaptchaVerifier/PhoneAuthProvider/etc. quedan expuestos
  // acá (scope del <script type="module">) porque el desafío de login
  // vive en el <script> plano de más abajo, que no tiene sus propios
  // imports — mismo motivo/patrón que window._doc/window._getDoc arriba
