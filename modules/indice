  async function seleccionarCliente(id) {
    if (MODO_NEGOCIO) {
      window.open(urlCrm('cliente=' + encodeURIComponent(id)), '_blank', 'noopener');
      return;
    }
    clienteActivo = clientes.find(c => c.id === id);
    if (!clienteActivo) return;

    // En mobile, elegir un cliente cierra el cajón del sidebar solo —
    // si no, taparía toda la ficha que se acaba de abrir. No-op en
    // desktop (el sidebar ahí no usa esta clase).
    cerrarSidebarMobile();

    // Actualizar sidebar
    renderClientes(clientesFiltrados());

    // Panel
    document.getElementById('empty-state').style.display   = 'none';
    document.getElementById('admin-dashboard-wrap').style.display = 'none';
    document.getElementById('secciones-estudio-wrap').style.display = 'none';
    ocultarPanelesGlobales();
    document.getElementById('cliente-panel').classList.add('visible');
    // La ficha del cliente es la ÚNICA pantalla que sigue usando el rail de
    // íconos (25/09/2026) — sus 13 tabs sí necesitan esa navegación densa,
    // a diferencia del resto del estudio (ver toggleRail()/mostrarBreadcrumb()
    // más arriba). El sidebar vuelve a mostrarse para poder saltar a otro
    // cliente sin volver antes a la sección "Clientes".
    toggleRail(true);
    toggleSidebarGlobal(true);
    mostrarBreadcrumb(false);
    document.getElementById('panel-name').textContent  = clienteActivo.razon_social || '—';
    document.getElementById('panel-cuit').textContent  = 'CUIT ' + formatCuit(clienteActivo.cuit || '');

    const badge = document.getElementById('panel-badge');
    if (clienteActivo.tipo === 'ri') {
      badge.textContent  = 'Responsable Inscripto';
      badge.className    = 'badge badge-ri';
    } else {
      badge.textContent  = 'Monotributista';
      badge.className    = 'badge badge-mono';
    }

    // Editar cliente: admin siempre; contador solo sus clientes asignados;
    // administrativo no edita (ver tabla de roles en CLAUDE.md)
    const puedeEditar = miRol === 'admin' || miRol === 'super_admin' ||
      (miRol === 'contador' && clienteActivo.contador_uid === window._auth.currentUser?.uid);
    document.getElementById('btn-editar-cliente').style.display = puedeEditar ? '' : 'none';

    // Archivar/restaurar cliente: mismo criterio que "Eliminar" en la
    // tabla de roles — solo admin/super_admin, ni siquiera el contador
    // asignado (a diferencia de "Editar cliente").
    document.getElementById('btn-archivar-cliente').style.display =
      (miRol === 'admin' || miRol === 'super_admin') ? '' : 'none';
    actualizarBotonArchivar();

    // Enviar recordatorio: mismo criterio que "Cargar consulta" en la
    // tabla de roles — admin/administrativo siempre, contador solo sus
    // clientes asignados. La Cloud Function revalida esto igual del lado
    // del servidor (ver functions/lib/recordatorio-manual.js).
    const puedeRecordar = miRol === 'admin' || miRol === 'administrativo' || miRol === 'super_admin' ||
      (miRol === 'contador' && clienteActivo.contador_uid === window._auth.currentUser?.uid);
    document.getElementById('btn-recordatorio').style.display = puedeRecordar ? '' : 'none';

    // Reenviar el mail de contraseña: solo si el cliente YA tiene acceso
    // creado (si no, lo que corresponde es dárselo desde los paneles de
    // onboarding/verificación, no reenviar nada). Mismo permiso que "Editar
    // cliente" — administrativo no entra, igual que en darAccesoApp.
    document.getElementById('btn-reenviar-pass').style.display =
      (puedeEditar && clienteActivo.acceso_uid && (clienteActivo.acceso_email || clienteActivo.email))
        ? '' : 'none';

    // Cambiar email / dar de baja de la app (16/10/2026, gestion-cuentas.js):
    // admin/super_admin. El email cambia también la cuenta con la que entra.
    const esAdminCRM = miRol === 'admin' || miRol === 'super_admin';
    document.getElementById('btn-cambiar-email-cliente').style.display =
      (esAdminCRM && (clienteActivo.email || clienteActivo.acceso_uid)) ? '' : 'none';
    document.getElementById('btn-baja-app-cliente').style.display =
      (esAdminCRM && (clienteActivo.acceso_uid || clienteActivo.plan_id)) ? '' : 'none';

    pintarMetaCliente(clienteActivo);
    actualizarMenuMas();
    actualizarBadgeTabConsultas();
    actualizarRailDisponibilidad(true);

    // Reset tab y carga inicial
    await switchTabById('inicio');
  }

  // Desde el panel de Comunicaciones (dashboard-general.js): seleccionar
  // el cliente y saltar directo a su tab Consultas, en vez de dejarlo en
  // "Inicio" (que es lo que hace seleccionarCliente sola).
  // Datos clave debajo del nombre (11/10/2026). Todo con textContent: son
  // datos que cargó el cliente o el alta web. Los nombres de los planes se
  // leen una vez de /planes_finnix; mientras tanto se muestra el plan_id.
  let nombresPlanes = null;
  function pintarMetaCliente(c) {
    const meta = document.getElementById('panel-meta');
    if (!meta || !c) return;
    meta.innerHTML = '';
    const item = (etiqueta, valor) => {
      if (!valor) return;
      const span = document.createElement('span');
      const b = document.createElement('b');
      b.textContent = etiqueta;
      span.append(b, document.createTextNode(String(valor)));
      meta.appendChild(span);
    };
    item('Contador', c.contador_nombre || (c.contador_uid ? '' : 'Sin asignar'));
    if (c.tipo === 'mono') item('Categoría', c.categoria_mono || c.categoria);
    item('IIBB', c.ingresos_brutos);
    item('Servicio', nombresServicios?.[c.plan] || ({ mono: 'Monotributista', ri: 'Responsable Inscripto', sociedad: 'Sociedades' })[c.plan] || '');
    // El Plan Básico (sin cargo) ya no es un sistema: se ve solo el servicio.
    if (c.plan_id && c.plan_id !== 'basico') {
      const nombre = nombresPlanes?.[c.plan_id] || c.plan_id;
      item('Sistema Finnix', nombre + (c.plan_estado && c.plan_estado !== 'activa' ? ' (' + c.plan_estado + ')' : ''));
    }
    // El plan se gestiona solo desde Finnix — mi negocio (12/10/2026), que es
    // solo de la dueña (un estudio en prueba no lo ve).
    if (esDuenoFinnix()) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'panel-meta-link';
      b.textContent = c.plan_id ? 'Gestionar sistema →' : 'Dar prueba o suscripción →';
      b.onclick = () => irAGestionPlan(c.id);
      meta.appendChild(b);
    }
    item('Email', c.email);
    item('Tel.', c.telefono);
    if (c.plan_id && !nombresPlanes) cargarNombresPlanes();
    if (c.plan && !nombresServicios) cargarNombresServicios();
  }
  // Catálogo de servicios del estudio (/servicios_estudio, 12/10/2026).
  let nombresServicios = null;
  async function cargarNombresServicios() {
    nombresServicios = {};
    try {
      const snap = await window._getDocs(window._collection(window._db, 'servicios_estudio'));
      snap.docs.forEach(d => { nombresServicios[d.id] = d.data().nombre || d.id; });
      if (clienteActivo) pintarMetaCliente(clienteActivo);
    } catch (e) { /* sin catálogo: quedan los nombres de siempre */ }
  }
  async function cargarNombresPlanes() {
    nombresPlanes = {};
    try {
      const snap = await window._getDocs(window._collection(window._db, 'planes_finnix'));
      snap.docs.forEach(d => { nombresPlanes[d.id] = d.data().nombre || d.id; });
      if (clienteActivo) pintarMetaCliente(clienteActivo);
