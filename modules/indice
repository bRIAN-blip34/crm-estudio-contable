  window._RecaptchaVerifier = RecaptchaVerifier;
  window._PhoneAuthProvider = PhoneAuthProvider;
  window._PhoneMultiFactorGenerator = PhoneMultiFactorGenerator;
  window._getMultiFactorResolver = getMultiFactorResolver;
  window._multiFactor = multiFactor;

  // ── PWA: instalable + push al personal del estudio (celu del contador,
  // ver CLAUDE.md "CRM instalable + push") ───────────────────────────
  // VAPID key del proyecto (Firebase Console → Configuración → Cloud
  // Messaging → "Certificados push web") — es del PROYECTO, no de la app,
  // así que es la MISMA que ya usa finnix-app (VITE_FIREBASE_VAPID_KEY en
  // su Vercel/.env). Sin mecanismo de env vars en este frontend sin
  // bundler (ver CLAUDE.md, "Stack"), va hardcodeada acá igual que
  // firebaseConfig — reemplazar el placeholder por el valor real.
  const CRM_VAPID_KEY = 'BLZBq_5UOi6tNhjITX78XsLB9VULmMEuDrbd4jCt_GeapGhvhmDEOLH26pEi1B1l_hws8UBtfe7wmsBAhCHQ_nQ';

  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('/sw.js')
      .catch((err) => console.error('Error al registrar el service worker:', err));
  }

  // Refleja en el botón de la topbar si este dispositivo ya tiene el
  // permiso concedido — no confirma que el token esté guardado en
  // Firestore (idempotente igual, no hace falta chequear), solo evita
  // mostrar "Activar" cuando ya no tiene sentido clickearlo.
  window._syncBtnPush = function () {
    const btn = document.getElementById('btn-push');
    if (!btn) return;
    if (typeof Notification === 'undefined') { btn.style.display = 'none'; return; }
    if (Notification.permission === 'granted') {
      btn.textContent = '🔔 Activadas';
      btn.disabled = true;
    }
  };

  // Pide permiso, obtiene el token FCM de este dispositivo y lo guarda en
  // /crm_users/{uid}/fcm_tokens/{token} — mismo patrón que
  // finnix-app/src/utils/push.js, adaptado a vanilla JS. Las Cloud
  // Functions lo leen con el Admin SDK para mandar los push (ver
  // functions/lib/push.js → enviarPushCRM).
  window.activarNotificacionesCRM = async function () {
    if (typeof Notification === 'undefined') {
      window._toast('Este navegador no soporta notificaciones push', 'error');
      return;
    }
    if (Notification.permission === 'denied') {
      window._toast('Notificaciones bloqueadas — habilitalas desde la configuración del navegador', 'error');
      return;
    }
    try {
      const soportado = await isSupported();
      if (!soportado) {
        window._toast('Este navegador no soporta notificaciones push', 'error');
        return;
      }
      const permiso = await Notification.requestPermission();
      if (permiso !== 'granted') return;

      const registration = await navigator.serviceWorker.ready;
      const messaging = getMessaging(app);
      const token = await getToken(messaging, {
        vapidKey: CRM_VAPID_KEY,
        serviceWorkerRegistration: registration,
      });
      if (!token) {
        window._toast('No se pudo obtener el token de notificaciones', 'error');
        return;
      }

      const user = auth.currentUser;
      if (!user) return;
      await setDoc(doc(db, 'crm_users', user.uid, 'fcm_tokens', token), {
        creado: new Date().toISOString(),
        plataforma: 'web',
      });

      window._toast('Notificaciones activadas', 'success');
      window._syncBtnPush();
    } catch (err) {
      console.error('Error al activar notificaciones:', err);
      window._toast('Error al activar notificaciones', 'error');
    }
  };

  // ── AUTH STATE ───────────────────────────────────────────────
  // mostrarApp() setea miRol (lee /crm_users/{uid}) — hay que esperarlo
  // antes de cargarClientes(), que decide su query según miRol. Sin este
  // await corrían en paralelo, cargarClientes() arrancaba con miRol
  // todavía null y siempre tomaba la rama sin filtro por contador.
  onAuthStateChanged(auth, async (user) => {
    if (user) {
      const tieneAcceso = await window.mostrarApp(user);
      if (tieneAcceso) {
        await window.cargarClientes();
        window._abrirDeepLink?.();
        window._syncBtnPush();
        window._iniciarPollingCRM();
      }
    } else {
      window._detenerPollingCRM();
      window.mostrarAuth();
    }
  });
