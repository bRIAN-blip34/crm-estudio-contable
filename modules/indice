  function toast(msg, tipo = 'info') {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.style.borderColor = tipo === 'error' ? 'var(--danger)' : tipo === 'ok' ? 'var(--success)' : 'var(--border)';
