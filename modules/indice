  async function toggleArchivarCliente() {
    if (!clienteActivo) return;
    const archivando = clienteActivo.activo !== false;
    const nombre = clienteActivo.razon_social || 'este cliente';
    const confirmMsg = archivando
      ? `¿Archivar a ${nombre}? Deja de aparecer en la lista de clientes activos — se puede restaurar después desde "Ver papelera". No se borra ningún dato.`
      : `¿Restaurar a ${nombre}? Vuelve a aparecer en la lista de clientes activos.`;
    if (!confirm(confirmMsg)) return;

    const btn = document.getElementById('btn-archivar-cliente');
    btn.disabled = true;
    try {
      await window._setDoc(window._doc(window._db, 'clientes', clienteActivo.id), { activo: !archivando }, { merge: true });
      clienteActivo.activo = !archivando;
      const idx = clientes.findIndex(c => c.id === clienteActivo.id);
      if (idx !== -1) clientes[idx].activo = !archivando;
      actualizarBotonArchivar();
      filtrarClientes();
      toast(archivando ? 'Cliente archivado' : 'Cliente restaurado', 'ok');
    } catch (e) {
      console.error('Error al archivar/restaurar cliente:', e);
      toast('No se pudo actualizar el cliente', 'error');
    } finally {
      btn.disabled = false;
    }
  }
