  // tabId nulo (Panel principal, cualquier sección del estudio, el índice)
  // simplemente no marca nada como activo, no hace falta resolver ids de
  // botones globales que ya no existen.
  function marcarRailActivo(tabId) {
    document.querySelectorAll('.rail-item').forEach(el => el.classList.remove('activo'));
    if (!tabId) return;
    const el = document.querySelector(`.rail-item[data-tab="${tabId}"]`);
    if (el) el.classList.add('activo');
  }
  // Las 8 secciones del cliente no tienen sentido sin un cliente elegido —
  // se deshabilitan con el atributo `disabled` nativo (no solo opacidad),
  // así ni el click ni el foco por teclado hacen nada hasta que hay uno.
  function actualizarRailDisponibilidad(habilitado) {
    document.querySelectorAll('.rail-item[data-tab]').forEach(el => { el.disabled = !habilitado; });
  }

  // ── Buscador rápido (Ctrl+K) + leyenda de colores del rail ────────
  // Nombre/descripción de cada color de grupo — el color en sí y qué
  // botones entran en cada uno NO se duplican acá: se leen en vivo del
  // propio --rail-tint de cada .rail-grupo, así nunca se puede
  // desincronizar con lo que el rail realmente pinta.
  const RAIL_GRUPO_META = {
    'violet':     { label: 'Negocio Finnix',         desc: 'Lo que Finnix le cobra directo al cliente — negocio de Aleja, no operación del estudio.' },
    'teal':       { label: 'Alta de clientes',       desc: 'Todo lo que arranca a un cliente nuevo, del link de onboarding al alta confirmada.' },
    'warn-2':     { label: 'Seguimiento de cartera', desc: 'Vigilar a toda la cartera: datos al día, topes de categoría y qué falta liquidar.' },
    'danger-2':   { label: 'Recursos Laborales',     desc: 'Enlaces oficiales y paritarias para el área laboral del estudio.' },
    'accent-2':   { label: 'Fiscal',                 desc: 'El trabajo del día a día: liquidar, cargar comprobantes, presentar y facturar.' },
    'teal-2':     { label: 'Comercial',              desc: 'Lo que se le cobra al cliente — honorarios del estudio y el plan Finnix.' },
    'violet-2':   { label: 'Comunicación',           desc: 'Notas internas del equipo y el chat con el cliente.' },
    'success-2':  { label: 'Integraciones',          desc: 'Conexiones con el resto del ecosistema Finnix.' },
  };
  const ICONO_CLIENTE_BUSCADOR = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c1-4.2 4-6.3 7-6.3s6 2.1 7 6.3"/></svg>';

  function tintDeGrupo(grupoEl) {
    const raw = (grupoEl && grupoEl.getAttribute('style')) || '';
    const m = raw.match(/--rail-tint:\s*var\(--([a-z0-9-]+)\)/i);
    return m ? m[1] : null;
  }

  // Lee el DOM real del rail (aria-label, display, disabled) en vez de
  // reimplementar qué ve cada rol — así el buscador nunca puede ofrecer
  // algo que el usuario no vería si mirara el rail directamente.
  function indiceBuscadorRapido() {
    const items = indiceBuscadorTodo();
    // Cada panel ofrece lo suyo (13/10/2026): en el del negocio, Finnix, .OS
    // y los clientes (abren su plan); en el del estudio, todo menos eso
    // (Finnix/.OS siguen, pero abren el otro panel).
    if (MODO_NEGOCIO) {
      return items
        .filter((it) => it.grupoLabel === 'Finnix' || it.grupoLabel === '.OS' || it.grupoLabel === 'Clientes')
        .map((it) => it.grupoLabel === 'Clientes' && it.clienteId
          ? { ...it, sub: it.sub + ' · ver su plan', onSeleccionar: () => irAGestionPlan(it.clienteId) } : it);
    }
    return items.filter((it) => it.grupoLabel !== 'Índice')
      .map((it) => (it.grupoLabel === 'Finnix' || it.grupoLabel === '.OS') ? { ...it, sub: 'Abre el panel de tu negocio' } : it);
  }
  function indiceBuscadorTodo() {
    const items = [];
    document.querySelectorAll('#rail .rail-item[aria-label]').forEach(btn => {
      if (getComputedStyle(btn).display === 'none' || btn.disabled) return;
      const grupoEl = btn.closest('.rail-grupo');
      const tint    = grupoEl ? tintDeGrupo(grupoEl) : null;
      const meta    = tint ? RAIL_GRUPO_META[tint] : null;
      items.push({
        grupoLabel: meta ? meta.label : 'Inicio',
        color:      tint ? ('var(--' + tint + ')') : 'var(--accent-2)',
        icono:      (btn.querySelector('svg') || {}).outerHTML || '',
        label:      btn.getAttribute('aria-label'),
