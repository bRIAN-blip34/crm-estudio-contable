  function asegurarBuscadorDom() {
    if (document.getElementById('qsearch-overlay')) return;
    document.body.insertAdjacentHTML('beforeend', `
      <div id="qsearch-overlay" style="display:none">
        <div class="qsearch-modal" role="dialog" aria-modal="true" aria-label="Buscador rápido">
          <div class="qsearch-input-row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M20 20l-4.3-4.3"/></svg>
            <input id="qsearch-input" placeholder="Buscar un panel o un cliente..." autocomplete="off" />
            <span class="topbar-kbd">Esc</span>
          </div>
          <div class="qsearch-results" id="qsearch-results"></div>
        </div>
      </div>`);
    document.getElementById('qsearch-input').addEventListener('input', (e) => filtrarBuscadorRapido(e.target.value));
    document.getElementById('qsearch-input').addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); qsearchSel = Math.min(qsearchSel + 1, qsearchFilas.length - 1); marcarSeleccionBuscador(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); qsearchSel = Math.max(qsearchSel - 1, 0); marcarSeleccionBuscador(); }
      else if (e.key === 'Enter') { e.preventDefault(); elegirBuscador(qsearchSel); }
      else if (e.key === 'Escape') { cerrarBuscadorRapido(); }
    });
    document.getElementById('qsearch-overlay').addEventListener('click', (e) => {
      if (e.target.id === 'qsearch-overlay') cerrarBuscadorRapido();
    });
  }

  function abrirBuscadorRapido() {
    if (!miRol) return; // sin sesión no hay nada que buscar
    asegurarBuscadorDom();
    const overlay = document.getElementById('qsearch-overlay');
    const input   = document.getElementById('qsearch-input');
    overlay.style.display = 'flex';
    input.value = '';
    filtrarBuscadorRapido('');
    setTimeout(() => input.focus(), 10);
  }
  window.abrirBuscadorRapido = abrirBuscadorRapido;

  function cerrarBuscadorRapido() {
    const overlay = document.getElementById('qsearch-overlay');
    if (overlay) overlay.style.display = 'none';
  }

  function normalizarTexto(s) {
    return (s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  }

  function filtrarBuscadorRapido(q) {
    const nq  = normalizarTexto(q);
    const all = indiceBuscadorRapido();
    const filtradas = nq
      ? all.filter(it => normalizarTexto(it.label).includes(nq) || normalizarTexto(it.sub).includes(nq))
      : all;
    renderResultadosBuscador(filtradas);
  }

  function renderResultadosBuscador(lista) {
    qsearchFilas = lista;
    qsearchSel   = 0;
    const box = document.getElementById('qsearch-results');
    if (!lista.length) {
      box.innerHTML = '<div class="qsearch-empty">Sin resultados. Probá con otra palabra.</div>';
      return;
    }
    const orden = [];
    const porGrupo = {};
    lista.forEach(it => {
      if (!porGrupo[it.grupoLabel]) { porGrupo[it.grupoLabel] = []; orden.push(it.grupoLabel); }
      porGrupo[it.grupoLabel].push(it);
    });
    let html = '';
    let idx  = 0;
    orden.forEach(g => {
      const color = porGrupo[g][0].color;
      html += '<div class="qsearch-group-label"><span class="qsearch-dot" style="background:' + color + '"></span>' + g + '</div>';
      porGrupo[g].forEach(it => {
        html += '<div class="qsearch-row" data-idx="' + idx + '">' +
          '<span class="qsearch-row-icon" style="--qr-tint:' + it.color + '">' + it.icono + '</span>' +
          '<span class="qsearch-row-txt"><span class="qsearch-row-label">' + it.label + '</span>' +
          (it.sub ? '<br><span class="qsearch-row-sub">' + it.sub + '</span>' : '') + '</span>' +
          '</div>';
        idx++;
      });
    });
    box.innerHTML = html;
    marcarSeleccionBuscador();
    document.querySelectorAll('.qsearch-row').forEach(row => {
      row.addEventListener('mouseenter', () => { qsearchSel = +row.dataset.idx; marcarSeleccionBuscador(); });
      row.addEventListener('click', () => elegirBuscador(+row.dataset.idx));
    });
  }

  function marcarSeleccionBuscador() {
    document.querySelectorAll('.qsearch-row').forEach(row => {
      row.classList.toggle('selected', +row.dataset.idx === qsearchSel);
    });
  }

  function elegirBuscador(idx) {
    const it = qsearchFilas[idx];
    if (!it) return;
    cerrarBuscadorRapido();
    it.onSeleccionar();
    window._toast('Te llevé a: ' + it.label);
  }

