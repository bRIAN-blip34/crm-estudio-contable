    const ok = await darDeBajaCuenta('cliente', clienteActivo.id, clienteActivo.razon_social || clienteActivo.email || 'el cliente');
    if (ok) await recargarClienteActivo();
  }
  // Vuelve a leer el cliente abierto y repinta la ficha (después de cambiar
  // su email o darlo de baja desde el servidor).
  async function recargarClienteActivo() {
    try {
      const snap = await window._getDoc(window._doc(window._db, 'clientes', clienteActivo.id));
      if (snap.exists()) {
        Object.keys(clienteActivo).forEach((k) => { if (k !== 'id') delete clienteActivo[k]; });
        Object.assign(clienteActivo, snap.data(), { id: snap.id });
        seleccionarCliente(clienteActivo.id);
      }
    } catch (e) { console.error('No se pudo recargar el cliente', e); }
  }
  window.cambiarEmailCliente = cambiarEmailCliente;
  window.darDeBajaAppCliente = darDeBajaAppCliente;

  async function reenviarContrasenaCliente() {
    if (!clienteActivo) return;
    const email = clienteActivo.acceso_email || clienteActivo.email;
    if (!email) { window._toast('El cliente no tiene email cargado', 'error'); return; }
    if (!confirm(`¿Reenviar el mail para definir la contraseña a ${email}?`)) return;

    const btn = document.getElementById('btn-reenviar-pass');
    const textoOriginal = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Enviando…';
    try {
      const { reenviarMailContrasena } = await import('./modules/admin/acceso-app.js?v=' + window._appVersion);
      await reenviarMailContrasena(email);
      window._toast(`✓ Mail enviado a ${email}`, 'success');
    } catch (e) {
      console.error('Error reenviando el mail de contraseña:', e);
      const msg = String(e.code || e.message || '');
      window._toast(
        msg.includes('user-not-found') ? 'Esa cuenta no existe en Auth — creá el acceso primero'
        : msg.includes('invalid-email') ? 'El email del cliente no es válido'
        : msg.includes('too-many-requests') ? 'Demasiados intentos seguidos, esperá unos minutos'
        : 'No se pudo enviar el mail',
        'error'
      );
    } finally {
      btn.disabled = false;
      btn.textContent = textoOriginal;
    }
  }

