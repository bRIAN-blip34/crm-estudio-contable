  async function cambiarEmailCliente() {
    if (!clienteActivo) return;
    const { cambiarEmailCuenta } = await import('./modules/admin/gestion-cuentas.js?v=' + window._appVersion);
    const ok = await cambiarEmailCuenta('cliente', clienteActivo.id, clienteActivo.acceso_email || clienteActivo.email);
