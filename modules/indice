            onclick="window._abrirAltaEstudio()">+ Nuevo estudio</button>
    <div class="topbar-right">
      <!-- Ir al otro panel (13/10/2026). Se muestran según el modo y el rol. -->
      <!-- Campanita (13/10/2026, modules/admin/campanita.js). -->
      <div class="campanita-wrap">
        <button type="button" class="btn-ghost campanita-btn" id="btn-campanita" style="display:none" aria-label="Avisos">🔔<span class="campanita-badge" id="campanita-badge" hidden></span></button>
        <div class="campanita-panel" id="campanita-panel" hidden></div>
