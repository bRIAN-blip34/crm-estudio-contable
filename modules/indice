      <a class="btn-ghost topbar-ir-negocio" id="btn-ir-negocio" style="display:none" target="_blank" rel="noopener">💼 Mi negocio ↗</a>
      <button class="btn-ghost" id="btn-buscar-rapido" onclick="abrirBuscadorRapido()" title="Buscar un panel o un cliente (Ctrl+K)">🔍 Buscar <span class="topbar-kbd">Ctrl K</span></button>
      <button class="btn-ghost" id="btn-ayuda" onclick="window._abrirAyuda()" title="Ayuda rápida sobre partes del CRM que se prestan a confusión">❓</button>
      <!-- Mi cuenta (11/10/2026): los botones de la cuenta propia vivían
           sueltos en esta barra y la llenaban. Mismos ids y onclick. -->
      <details class="topbar-cuenta" id="topbar-cuenta">
        <summary class="topbar-cuenta-btn" title="Mi cuenta">
          <span class="topbar-user">
            <span class="topbar-user-saludo" id="topbar-saludo"></span>
            <span class="topbar-user-email" id="topbar-email"></span>
          </span>
          <span class="topbar-cuenta-flecha" aria-hidden="true">▾</span>
        </summary>
        <div class="topbar-cuenta-menu">
          <button class="btn-ghost" id="btn-push" onclick="activarNotificacionesCRM()">🔔 Notificaciones</button>
          <button class="btn-ghost" id="btn-mfa" onclick="window._abrirMFA()">🔒 Verificación en 2 pasos</button>
          <button class="btn-ghost" id="btn-password" onclick="window._abrirPassword()">🔑 Cambiar contraseña</button>
          <button class="btn-ghost" id="btn-passkey" onclick="window._abrirPasskey()">👆 Ingresar con huella</button>
          <button class="btn-ghost" id="btn-usuarios" style="display:none" onclick="abrirUsuariosCRM()">👥 Usuarios del CRM</button>
          <button class="btn-ghost" id="btn-leyenda-rail" onclick="abrirLeyendaRail()">🎨 Colores de las pestañas</button>
          <button class="btn-ghost topbar-salir" onclick="handleLogout()">Salir</button>
        </div>
      </details>
    </div>
  </div>

  <!-- Menú del panel del negocio (13/10/2026, solo en modo negocio). -->
  <nav class="negocio-nav" id="negocio-nav" hidden aria-label="Secciones de mi negocio">
    <button type="button" class="negocio-nav-btn" data-negocio-nav="finnix" onclick="irSuscripciones()">Finnix — sistemas y suscripciones</button>
    <button type="button" class="negocio-nav-btn" data-negocio-nav="os" onclick="irOnboardingComercio()">.OS — terminales y kits</button>
    <button type="button" class="negocio-atencion" id="negocio-atencion" hidden onclick="window._campanitaAbrir && window._campanitaAbrir('atencion')"></button>
    <a class="negocio-nav-estudio" id="negocio-ir-estudio" href="https://crm.finnix.com.ar/" target="_blank" rel="noopener">Estudio contable ↗</a>
  </nav>

  <!-- Main -->
  <div class="main-layout">

    <!-- Rail de íconos: Inicio del estudio/contador + las 8 secciones del
         cliente activo (antes eran pestañas horizontales arriba de la
         ficha, ver switchTabById/marcarRailActivo/actualizarRailDisponibilidad
         en el script de abajo). Los data-tab coinciden con los ids que ya
         usaba switchTabById, así que el resto de la lógica de carga de
         cada módulo no cambia. -->
    <!-- Las pestañas de la ficha (antes un rail de íconos acá) viven ahora
         dentro de #cliente-panel, debajo del encabezado del cliente. -->

    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="sidebar-header">
        <span class="sidebar-title">Clientes</span>
        <input class="search-input" id="search-input" type="text" placeholder="Buscar por nombre o CUIT…" oninput="filtrarClientes()"/>
      </div>

      <div class="sidebar-filters">
        <button class="filter-pill active" data-filter="todos" onclick="setFiltro(this)">Todos</button>
        <button class="filter-pill" data-filter="ri"   onclick="setFiltro(this)">R.I.</button>
        <button class="filter-pill" data-filter="mono" onclick="setFiltro(this)">Mono</button>
      </div>

      <div class="cliente-list" id="cliente-list">
        <!-- Se puebla con JS -->
      </div>

      <!-- "+ Nuevo cliente"/"Importar desde Excel/CSV"/"Reasignar contador
           (masivo)"/"Cargar teléfonos/emails (masivo)" vivían acá hasta el
           25/09/2026 — pedido explícito del usuario: se sentían mezclados
           con "buscar y ver un cliente", que es lo único que hace esta
           sección ahora. Los 4 pasaron a su propia sección ("Altas de
           clientes", modules/admin/altas-clientes.js, tarjeta en
           modules/admin/secciones-estudio.js) — mismas funciones de
           siempre (abrirAltaCliente/abrirImportarClientes/etc.), ya
           expuestas en window, solo cambió desde dónde se llaman.
           "Ver papelera" se queda: es un filtro de VISTA sobre esta misma
           lista, no una acción de alta. -->
      <div class="sidebar-add">
        <button class="btn-add" id="btn-papelera" style="display:none" onclick="togglePapelera()">
          <span>🗑</span> <span id="btn-papelera-label">Ver papelera</span>
        </button>
      </div>
    </aside>

    <!-- Solo se ve/activa en mobile (ver CSS @media) — cierra el cajón
         del sidebar al tocar afuera. En desktop el sidebar empuja el
         layout en vez de superponerse, no hace falta backdrop ahí. -->
    <div id="sidebar-backdrop" onclick="toggleSidebar()"></div>

    <button class="sidebar-toggle" id="sidebar-toggle" onclick="toggleSidebar()" title="Colapsar/expandir lista de clientes">
      <span id="sidebar-toggle-icon">‹</span>
    </button>

    <!-- Panel principal -->
    <main class="main-panel" id="main-panel">

      <!-- Breadcrumb "← Panel principal" (25/09/2026) — reemplaza al rail
           en toda sección del estudio que no sea la ficha de un cliente,
           ver mostrarBreadcrumb() más abajo. -->
      <div class="panel-breadcrumb" id="panel-breadcrumb">
        <button type="button" onclick="irInicio()">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
          Panel principal
        </button>
      </div>

      <!-- Estado vacío -->
      <div class="empty-state" id="empty-state">
        <div class="empty-icon">⌗</div>
        <p class="empty-title">Seleccioná un cliente</p>
        <p class="empty-sub">o creá uno nuevo desde el panel izquierdo</p>
      </div>

      <!-- Índice de mundos (24/09/2026) — punto de entrada nuevo para
           admin/super_admin: Estudio contable / Finnix / .OS, ver
           modules/admin/mundos.js e irMundos()/irLogo() más abajo. No
           reemplaza ningún panel existente, solo agrega uno nuevo. -->
      <div id="mundos-panel-wrap" style="display:none;flex:1;overflow-y:auto;padding:24px 28px;"></div>

      <!-- Panel general (admin, reemplaza el estado vacío) -->
      <!-- Secciones del estudio arriba de todo (11/10/2026): son el menú del
           estudio (clientes, altas, impuestos...), separado del resumen con
           números que va debajo. Ver secciones-estudio.js. -->
      <div id="secciones-estudio-wrap" style="display:none;padding:24px 28px 4px;flex-shrink:0;"></div>
      <!-- flex:0 0 auto (11/10/2026): con flex:1 y su propio scroll se achicaba
           y quedaba cortado debajo de "Secciones"; ahora scrollea .main-panel. -->
      <div id="admin-dashboard-wrap" style="display:none;flex:0 0 auto;padding:16px 28px 28px;"></div>

      <!-- Secciones del estudio (25/09/2026, modules/admin/secciones-estudio.js)
           — reemplaza a los íconos que antes vivían en el rail global
           (Enlaces de Onboarding, Clientes Pendientes, Verificación,
           Monotributo, DDJJ, Seguimiento, Laboral) más las dos secciones
           nuevas (Clientes, Centro de Notificaciones). Se muestra siempre
           junto con admin-dashboard-wrap (mismo panel, dos módulos que
           renderizan cada uno su parte) — ver irInicio() más abajo. -->

      <!-- Panel Suscripciones (segundo ítem global del rail, ver
           irSuscripciones()) — cartera del pivote de venta directa
           (plan_id/plan_estado) vista aparte del panel de arriba, que es
           sobre honorarios/comunicaciones del modelo viejo -->
      <div id="suscripciones-panel-wrap" style="display:none;flex:1;overflow-y:auto;padding:24px 28px;"></div>

      <div id="onboarding-links-panel-wrap" style="display:none;flex:1;overflow-y:auto;"></div>

      <div id="onboarding-clientes-panel-wrap" style="display:none;flex:1;overflow-y:auto;"></div>

      <div id="onboarding-comercio-panel-wrap" style="display:none;flex:1;overflow-y:auto;"></div>

      <div id="verificacion-panel-wrap" style="display:none;flex:1;overflow-y:auto;"></div>
      <div id="monotributo-panel-wrap" style="display:none;flex:1;overflow-y:auto;padding:24px 28px;"></div>

      <!-- Panel "DDJJ del período" (modules/liquidacion/ddjj.js) — vista
           cruzada de toda la cartera para un período elegido, no reemplaza
           al tab "Exportar" de cada cliente (donde se calcula/presenta) -->
      <div id="ddjj-panel-wrap" style="display:none;flex:1;overflow-y:auto;padding:24px 28px;"></div>
      <div id="seguimiento-panel-wrap" style="display:none;flex:1;overflow-y:auto;padding:24px 28px;"></div>
      <!-- Tareas del mes (12/10/2026, modules/admin/tareas-mes.js) -->
      <div id="tareas-panel-wrap" style="display:none;flex:1;overflow-y:auto;padding:24px 28px;"></div>
      <div id="contactos-web-panel-wrap" style="display:none;flex:1;overflow-y:auto;padding:24px 28px;"></div>
      <div id="laboral-panel-wrap" style="display:none;flex:1;overflow-y:auto;padding:24px 28px;"></div>

      <!-- Centro de Notificaciones (25/09/2026, modules/admin/notificaciones.js)
