           irNotificaciones() más abajo. -->
      <div id="notificaciones-panel-wrap" style="display:none;flex:1;overflow-y:auto;padding:24px 28px;"></div>

      <!-- Altas de clientes (25/09/2026, modules/admin/altas-clientes.js) —
           hub con las 4 acciones que hasta acá vivían siempre visibles en
           el sidebar (Nuevo cliente/Importar Excel-CSV/Reasignar contador/
           Cargar teléfonos-emails), ver irAltasClientes() más abajo. -->
      <div id="altas-clientes-panel-wrap" style="display:none;flex:1;overflow-y:auto;padding:24px 28px;"></div>

      <!-- Panel cliente -->
      <div class="cliente-panel" id="cliente-panel">
        <div class="panel-header">
          <div class="panel-info">
            <div>
              <div class="panel-name" id="panel-name">—</div>
              <div class="panel-cuit" id="panel-cuit">—</div>
              <!-- Datos clave del cliente a la vista (11/10/2026): contador,
                   plan, categoría, IIBB y contacto. Ver pintarMetaCliente(). -->
              <div class="panel-meta" id="panel-meta"></div>
            </div>
            <div class="panel-acciones" style="display:flex;align-items:center;gap:10px">
              <span class="badge" id="panel-badge">—</span>
              <button class="fx-btn-ghost" id="btn-recordatorio" style="display:none" onclick="abrirRecordatorio()">
                🔔 Enviar recordatorio
              </button>
              <button class="fx-btn-ghost" id="btn-editar-cliente" style="display:none" onclick="abrirEditarCliente()">
                Editar cliente
              </button>
              <!-- Acciones que se usan poco, juntas en un menú (11/10/2026).
                   Mismos ids: seleccionarCliente() les sigue cambiando el
                   display, y actualizarMenuMas() esconde el menú si no queda
                   ninguna visible. -->
              <details class="panel-mas" id="panel-mas">
                <summary class="fx-btn-ghost">Más ▾</summary>
                <div class="panel-mas-menu">
                  <button class="fx-btn-ghost" id="btn-reenviar-pass" style="display:none" onclick="reenviarContrasenaCliente()">
                    🔑 Reenviar contraseña
                  </button>
                  <button class="fx-btn-ghost" id="btn-cambiar-email-cliente" style="display:none" onclick="cambiarEmailCliente()">
                    ✉ Cambiar email de acceso
                  </button>
                  <button class="fx-btn-ghost" id="btn-baja-app-cliente" style="display:none;color:var(--danger-2)" onclick="darDeBajaAppCliente()">
                    ⛔ Dar de baja de la app
                  </button>
                  <button class="fx-btn-ghost" id="btn-archivar-cliente" style="display:none" onclick="toggleArchivarCliente()">
                    🗑 Archivar cliente
                  </button>
                </div>
              </details>
            </div>
          </div>
          <!-- Solo visible con un cliente marcado demo:true (ver CLAUDE.md
               "Cuentas demo") — recordatorio para el personal del estudio
               de que esta ficha no es un cliente real, y de que emitir
               factura/generar suscripción está bloqueado a propósito. -->
          <div class="panel-demo-banner" id="panel-demo-banner" style="display:none">
            🎬 Cuenta de demostración — no es un cliente real. Facturación electrónica y suscripción de MercadoPago están bloqueadas.
          </div>
          <!-- Solo visible con un cliente archivado (activo:false) — el
               resto de la ficha sigue andando normal (archivar es un flag,
               no borra ni oculta ningún dato del cliente). -->
          <div class="panel-archivado-banner" id="panel-archivado-banner" style="display:none">
            🗑 Este cliente está archivado — no aparece en la lista de clientes activos.
          </div>
        <nav class="rail" id="rail" aria-label="Secciones de la ficha del cliente">
          <!-- Inicio/Suscripciones/Alta de comercio .OS/Enlaces de Onboarding/
               Clientes Pendientes/Verificación/Monotributo/DDJJ/Seguimiento/
               Recursos Laborales dejaron de vivir acá el 25/09/2026 — son
