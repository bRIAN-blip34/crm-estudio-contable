  let miRol         = null;
  // Refresco automático liviano del CRM (ver "Rendimiento a escala" /
  // conversación sobre certeza de recibir consultas con 150 clientes) —
  // el CRM no tiene onSnapshot en ningún lado, así que sin esto la única
  // vía "en vivo" para enterarse de un mensaje nuevo es el push (opt-in,
  // depende de que el contador lo haya activado). pollingIntervalId
  // guarda el setInterval activo (null = apagado, entre login y logout);
  // pollingTick cuenta las corridas para espaciar el refresco del panel
  // de Inicio (5 queries collectionGroup en modo admin), que sería
  // desperdicio pedir cada 90s si nadie lo está mirando en ese momento.
  let pollingIntervalId = null;
  let pollingTick       = 0;

  // Quién es dueño del negocio de Finnix, no de la operación del estudio:
  // asignar planes, ver precios, onboarding y el panel Suscripciones (ver
  // CLAUDE.md sección 0). Un contador liquida y presenta, no vende.
  const esDuenoDelNegocio = () => miRol === 'admin' || miRol === 'super_admin';
  // Finnix — mi negocio y .OS (26/10/2026, estudios en prueba): solo la dueña
  // (super_admin o admin del estudio de Finnix). El admin de otro estudio
  // maneja su estudio, no el negocio de Finnix. Mismo corte que esAdminFinnix()
  // en firestore.rules y esDuenoFinnix() en functions/lib/dueno-finnix.js.
  const esDuenoFinnix = () => miRol === 'super_admin' ||
    (miRol === 'admin' && (window._estudioId || ESTUDIO_ID_DEFAULT) === 'insfran');
  window._esDuenoFinnix = esDuenoFinnix;
  // Rol "laboral" (09/09/2026, ver CLAUDE.md "Recursos Laborales") — el
  // área que liquida sueldos en su propio Excel, fuera del CRM. Su único
  // acceso acá es el panel de enlaces oficiales + acuerdos paritarios;
  // admin/super_admin también lo ven (son quienes lo pueden gestionar del
  // todo, ver firestore.rules).
  const puedeVerRecursosLaborales = () => miRol === 'admin' || miRol === 'laboral' || miRol === 'super_admin';
  // admin y contador tienen panel de inicio con KPIs (dashboard-general.js);
  // el resto de los roles cae al empty-state de siempre. irInicio() lo usa
  // para saber a cuál de los dos volver.
  let dashboardDisponible = false;
