  // Traduce los códigos de error más frecuentes de Firestore/Auth a una
  // frase en castellano — sin esto, "mostrar el error real" (ver CLAUDE.md,
  // heurística H9) terminaba mostrando el string crudo del SDK, en inglés
  // ("Missing or insufficient permissions.", "Failed to fetch"), en medio
  // de una app 100% en español (H2 — coincidencia con el mundo real de
  // quien la usa). Un FirebaseError trae `.code` (ej. "permission-denied"
  // o "firestore/permission-denied" según el SDK) — si no lo reconoce, o
  // si el error no tiene `.code` en absoluto (un throw común, un error de
  // parseo de archivo), cae al mensaje real de siempre, y si tampoco hay
  // mensaje, al texto que ya se usaba antes de este helper.
  const MENSAJES_ERROR_CODIGO = {
    'permission-denied':     'No tenés permiso para hacer esto.',
    'unauthenticated':       'Tu sesión expiró — volvé a iniciar sesión.',
    'not-found':             'No se encontró lo que buscabas.',
    'already-exists':        'Ya existe un registro igual.',
    'resource-exhausted':    'Se alcanzó un límite del sistema — probá de nuevo más tarde.',
    'failed-precondition':   'La operación no se puede completar en este momento.',
    'aborted':               'Otra operación pisó esta escritura — probá de nuevo.',
    'deadline-exceeded':     'La operación tardó demasiado — probá de nuevo.',
    'unavailable':           'Sin conexión con el servidor — probá de nuevo en un momento.',
    'cancelled':             'Se canceló la operación.',
    'internal':              'Error interno del servidor — probá de nuevo.',
    'invalid-argument':      'Alguno de los datos cargados no es válido.',
  };
  // ⚠ 16/09/2026 — bug real encontrado al probar "+ Nueva factura" con un
  // ítem sin IVA cargado: ARCA rechazó con un motivo clarísimo ("Si
  // ImpNeto es mayor a 0 el objeto IVA es obligatorio"), varias Cloud
  // Functions de este proyecto lo reenvían tal cual con
  // `throw new HttpsError('internal', motivo)` (ver
  // functions/lib/facturacion-electronica.js, mercadopago-config.js) — pero
  // esta función, tal como quedó al agregar la traducción de errores,
  // pisaba SIEMPRE ese texto específico con el genérico del diccionario
  // ("Error interno del servidor — probá de nuevo.") apenas veía
  // `functions/internal`, sin importar que el mensaje real trajera el
  // motivo exacto. Traducir códigos de Firestore/Auth (mensaje siempre
  // genérico en inglés del SDK) es una cosa; un HttpsError de una Cloud
  // Function de ESTE proyecto es otra — el mensaje que el propio código
  // le puso a mano ES la explicación real, hay que mostrarla, no
  // reemplazarla. Solo cuando el mensaje es un crash sin manejar (ahí el
  // SDK de Functions sintetiza el propio nombre del código, ej.
  // "internal" a secas, sin explicación) tiene sentido el texto genérico.
  function mensajeError(e, fallback) {
    if (!e) return fallback;
    const codigoCrudo = e.code ? String(e.code) : null;
    const esFunctions = codigoCrudo ? codigoCrudo.startsWith('functions/') : false;
    const codigo = codigoCrudo ? codigoCrudo.replace(/^(firestore|auth|functions)\//, '') : null;
    if (esFunctions && e.message && codigo && e.message.toLowerCase() !== codigo.toLowerCase()) {
      return e.message;
    }
    if (codigo && MENSAJES_ERROR_CODIGO[codigo]) return MENSAJES_ERROR_CODIGO[codigo];
    if (e.name === 'TypeError' && /fetch/i.test(e.message || '')) return 'Sin conexión a internet — probá de nuevo.';
    return e.message || fallback;
  }
  window._mensajeError = mensajeError;

  // ── AUTH ─────────────────────────────────────────────────────
  // Verificación en dos pasos (SMS, opcional por cuenta — ver
  // modules/admin/mfa.js y CLAUDE.md "Seguridad de las cuentas").
  // Estado del desafío en curso, mientras la pantalla de login espera el
  // código: mfaResolver resuelve el signIn una vez verificado el código,
  // mfaVerificationId identifica el SMS que se mandó.
  let mfaResolver = null;
  let mfaVerificationId = null;

  async function handleLogin() {
    const email = document.getElementById('login-email').value.trim();
    const pass  = document.getElementById('login-pass').value;
    const btn   = document.getElementById('btn-login');
    const err   = document.getElementById('auth-error');

    if (!email || !pass) { err.textContent = 'Completá todos los campos.'; return; }

    btn.disabled = true;
    btn.innerHTML = '<span class="spinner"></span>';
    err.textContent = '';

    try {
      await window._signInWithEmailAndPassword(window._auth, email, pass);
    } catch (e) {
      if (e.code === 'auth/multi-factor-auth-required') {
        await iniciarDesafioMfa(e);
        btn.disabled = false;
        btn.textContent = 'Ingresar';
        return;
      }
      const msgs = {
        'auth/user-not-found':   'Usuario no encontrado.',
        'auth/wrong-password':   'Contraseña incorrecta.',
        'auth/invalid-email':    'Correo inválido.',
        'auth/too-many-requests':'Demasiados intentos. Esperá un momento.',
      };
      err.textContent = msgs[e.code] || 'Error al iniciar sesión.';
      btn.disabled = false;
      btn.textContent = 'Ingresar';
    }
  }

  // Cuenta con verificación en dos pasos activada: Firebase corta el
  // signIn con auth/multi-factor-auth-required en vez de loguear directo.
  // Acá se dispara el SMS al teléfono ya enrolado y se muestra el segundo
  // paso — el código en sí se valida en handleMfaVerify().
  async function iniciarDesafioMfa(mfaError) {
    try {
      mfaResolver = window._getMultiFactorResolver(window._auth, mfaError);
      const hint = mfaResolver.hints[0]; // único factor soportado hoy: teléfono
      if (!window._recaptchaVerifier) {
        window._recaptchaVerifier = new window._RecaptchaVerifier(
          window._auth, 'recaptcha-container', { size: 'invisible' }
        );
      }
      const phoneProvider = new window._PhoneAuthProvider(window._auth);
      mfaVerificationId = await phoneProvider.verifyPhoneNumber(
        { multiFactorHint: hint, session: mfaResolver.session },
        window._recaptchaVerifier
      );
      document.getElementById('auth-login-step').style.display = 'none';
      document.getElementById('auth-mfa-step').style.display = 'flex';
      document.getElementById('auth-mfa-step').style.flexDirection = 'column';
      document.getElementById('auth-mfa-step').style.gap = '16px';
      document.getElementById('auth-mfa-phone-hint').textContent = hint.phoneNumber || 'tu teléfono';
      document.getElementById('mfa-code').value = '';
      document.getElementById('auth-mfa-error').textContent = '';
      document.getElementById('mfa-code').focus();
    } catch (err) {
      console.error('Error al iniciar el desafío de verificación en dos pasos:', err);
      document.getElementById('auth-error').textContent =
        'No se pudo enviar el código de verificación. Probá de nuevo.';
    }
  }

  async function handleMfaVerify() {
    const code = document.getElementById('mfa-code').value.trim();
    const btn  = document.getElementById('btn-mfa-verify');
    const err  = document.getElementById('auth-mfa-error');
    if (!code) { err.textContent = 'Ingresá el código.'; return; }
    if (!mfaResolver || !mfaVerificationId) {
      err.textContent = 'La verificación expiró — volvé atrás e intentá de nuevo.';
      return;
    }

    btn.disabled = true;
    btn.innerHTML = '<span class="spinner"></span>';
    err.textContent = '';

    try {
      const cred = window._PhoneAuthProvider.credential(mfaVerificationId, code);
      const assertion = window._PhoneMultiFactorGenerator.assertion(cred);
      await mfaResolver.resolveSignIn(assertion);
      mfaResolver = null;
      mfaVerificationId = null;
      // onAuthStateChanged (script de módulo) se encarga del resto —
      // mismo flujo que un login sin MFA.
    } catch (e) {
      const msgs = {
        'auth/invalid-verification-code': 'Código incorrecto.',
        'auth/code-expired':              'El código venció — volvé atrás y pedí uno nuevo.',
      };
      err.textContent = msgs[e.code] || 'No se pudo verificar el código.';
      btn.disabled = false;
      btn.textContent = 'Verificar';
    }
  }

  function handleMfaCancel() {
    mfaResolver = null;
    mfaVerificationId = null;
    document.getElementById('auth-mfa-step').style.display = 'none';
    document.getElementById('auth-login-step').style.display = '';
    document.getElementById('login-pass').value = '';
    document.getElementById('btn-mfa-verify').disabled = false;
    document.getElementById('btn-mfa-verify').textContent = 'Verificar';
  }

  async function handleLogout() {
    detenerPollingCRM();
    window._campanitaCortar?.();
    await window._signOut(window._auth);
    clienteActivo = null;
    clientes = [];
    miRol = null;
    dashboardDisponible = false;
    document.getElementById('cliente-list').innerHTML = '';
    document.getElementById('topbar-saludo').textContent = '';
    document.getElementById('empty-state').style.display = '';
    document.getElementById('admin-dashboard-wrap').style.display = 'none';
    document.getElementById('secciones-estudio-wrap').style.display = 'none';
    document.getElementById('cliente-panel').classList.remove('visible');
    toggleRail(false);
    toggleSidebarGlobal(false);
    mostrarBreadcrumb(false);
    marcarRailActivo(null);
    actualizarRailDisponibilidad(false);
  }

  // Enter en login
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && document.getElementById('auth-screen').style.display !== 'none') {
      handleLogin();
    }
  });

  // ── CLIENTES ─────────────────────────────────────────────────
  async function cargarClientes() {
    // "laboral" no es esCRM() (ver firestore.rules) — nunca pasaría esta
    // query, y sin este corte cada login le tiraba un toast de error
    // apenas entraba. No tiene ninguna razón para ver la cartera fiscal.
    if (miRol === 'laboral') {
      clientes = [];
      renderClientes([]);
      return;
    }
    try {
      // where('estudio_id', ...) en las dos ramas: no es solo para
      // acotar el resultado, es requisito para que la query pase la
      // regla de Firestore — una regla que depende de resource.data no
      // filtra por documento sola en una lista sin este where (mismo
      // motivo que las 5 reglas collectionGroup del panel de admin, ver
      // firestore.rules "COLLECTION GROUP"; acá aplica igual aunque sea
      // una colección directa, no un collectionGroup). Sin esto, el
      // sidebar mostraba clientes de CUALQUIER estudio.
      const q = miRol === 'contador'
        ? window._query(
            window._collection(window._db, 'clientes'),
            window._where('contador_uid', '==', window._auth.currentUser.uid),
            window._where('estudio_id', '==', window._estudioId),
            window._orderBy('razon_social'),
          )
        : window._query(
            window._collection(window._db, 'clientes'),
            window._where('estudio_id', '==', window._estudioId),
            window._orderBy('razon_social'),
          );

      const snap = await window._getDocs(q);
      clientes = snap.docs.map(d => ({ id: d.id, ...d.data() }));
      // clientesFiltrados(), no clientes a secas — si no, un cliente
      // archivado aparecía un instante en el primer pintado, antes de
      // que cargarConsultasSinLeer() terminara y llamara a
      // filtrarClientes() para sacarlo.
      renderClientes(clientesFiltrados());
      cargarConsultasSinLeer(); // fire-and-forget: no bloquea el primer paint de la sidebar
    } catch (e) {
      console.error('Error cargando clientes:', e);
      toast('No se pudieron cargar los clientes', 'error');
    }
  }
  window.cargarClientes = cargarClientes;

  // Punto rojo de "mensajes sin leer" — consultas_sin_leer viene
  // denormalizado en el propio doc del cliente (lo mantiene al día
  // onConsultaEscrita, ver functions/lib/consultas-crm.js), así que la
  // gran mayoría sale de acá sin ningún query nuevo: antes esto era 1
  // query por cliente en CADA carga del CRM (ver CLAUDE.md, "Rendimiento
  // a escala") — con cientos de clientes, cientos de queries en paralelo
  // solo para pintar un punto.
  // Fallback: un cliente cuyo doc todavía no tiene el campo (viejo, sin
  // ninguna consulta creada/actualizada desde que se desplegó esto) se
  // resuelve con el query de siempre, pero SOLO para esos — converge
  // solo con el uso normal, no hace falta backfill manual en Firestore.
  async function cargarConsultasSinLeer() {
    const map = new Map();
    const pendientes = [];
    for (const c of clientes) {
      if (c.consultas_sin_leer !== undefined) {
        if (c.consultas_sin_leer > 0) map.set(c.id, c.consultas_sin_leer);
      } else {
        pendientes.push(c);
      }
    }
    if (pendientes.length) {
      try {
        const resultados = await Promise.all(pendientes.map(async c => {
          const snap = await window._getDocs(window._collection(window._db, `clientes/${c.id}/consultas`));
          const sinLeer = snap.docs.filter(d => d.data().leida_por_contador !== true).length;
          return [c.id, sinLeer];
        }));
        resultados.forEach(([id, n]) => { if (n > 0) map.set(id, n); });
      } catch (e) {
        console.error('Error al chequear consultas sin leer (fallback):', e);
      }
    }
    consultasSinLeer = map;
    filtrarClientes();
    actualizarBadgeTabConsultas();
  }

  // Refresca el punto de la tab "Consultas" para el cliente activo — lo
  // llama consultas.js después de marcar como leídas las que se acaban de
  // ver, así el punto desaparece sin esperar a la próxima carga completa.
  function actualizarBadgeTabConsultas() {
    const tab = document.getElementById('rail-consultas');
    if (!tab) return;
    const tieneSinLeer = clienteActivo && consultasSinLeer.get(clienteActivo.id) > 0;
    tab.classList.toggle('has-badge', !!tieneSinLeer);
  }
  window._marcarConsultasLeidas = function(clienteId) {
    consultasSinLeer.delete(clienteId);
    filtrarClientes();
    actualizarBadgeTabConsultas();
  };

  // ── REFRESCO AUTOMÁTICO ──────────────────────────────────────
  // El CRM no tiene onSnapshot en ningún lado — todo se recalcula al
  // cargar o al tocar "Actualizar" a mano. La única vía "en vivo" hasta
  // ahora era el push (onConsultaCreada), que depende de que el contador
  // lo haya activado (opt-in) y de que el permiso siga concedido ese día.
  // Con una cartera de varios contadores esto puede dejar un mensaje sin
  // verse hasta la próxima recarga. Este polling no reemplaza al push —
  // es la red de seguridad para cuando no llegó.
  const INTERVALO_POLLING_MS = 90 * 1000; // 90s: sidebar liviano, no vale la pena más seguido
  const CADA_N_TICKS_DASHBOARD = 3;       // el panel de Inicio recién cada ~4.5min (5 queries en modo admin)

  async function tickPolling() {
    // No gastar lecturas con la pestaña en segundo plano o sin sesión —
    // ni falta hace: al volver a foco, el listener de abajo dispara un
    // tick inmediato.
    if (document.visibilityState !== 'visible' || !window._auth?.currentUser) return;

    try {
      // Sidebar + punto rojo — 1 query liviana (consultas_sin_leer ya
      // viene denormalizado en el propio doc, ver cargarConsultasSinLeer).
      await cargarClientes();

      // Si el contador tiene abierto justo el chat de un cliente, lo
      // refresca también — si no, un mensaje nuevo mientras mira esa
      // pantalla quedaría invisible hasta que tocara "Actualizar" a mano.
      if (clienteActivo && document.getElementById('rail-consultas')?.classList.contains('activo')
          && window._consRecargar) {
        await window._consRecargar();
      }

      // El panel de Inicio (KPIs + kanban de Comunicaciones) es más caro
      // — se refresca solo si es la vista activa, y no en cada tick.
      pollingTick++;
      const inicioActivo = !clienteActivo && dashboardDisponible &&
        document.getElementById('admin-dashboard-wrap').style.display !== 'none';
      if (inicioActivo && pollingTick % CADA_N_TICKS_DASHBOARD === 0 && window._dgCargar) {
        await window._dgCargar();
      }
    } catch (e) {
      // No molesta con un toast — es un refresco de fondo, no una acción
      // que el usuario disparó; si falla, el próximo tick lo reintenta.
      console.error('Error en el refresco automático:', e);
    }
  }

  function iniciarPollingCRM() {
    detenerPollingCRM(); // por si quedó uno corriendo (re-login sin recargar la página)
    pollingTick = 0;
    pollingIntervalId = setInterval(tickPolling, INTERVALO_POLLING_MS);
  }
  function detenerPollingCRM() {
    if (pollingIntervalId) { clearInterval(pollingIntervalId); pollingIntervalId = null; }
  }
  window._iniciarPollingCRM = iniciarPollingCRM;
  window._detenerPollingCRM = detenerPollingCRM;

  // Al volver a la pestaña (ej. el contador estuvo en otra ventana) se
  // refresca al toque, en vez de esperar hasta 90s con datos viejos.
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible' && pollingIntervalId) tickPolling();
  });

  function renderClientes(lista) {
    const el = document.getElementById('cliente-list');

    if (!lista.length) {
      el.innerHTML = `<div style="padding:24px 16px;color:var(--text-3);font-size:13px;text-align:center;">
        ${verPapelera ? 'Papelera vacía' : 'Sin resultados'}
      </div>`;
      return;
    }

    el.innerHTML = lista.map(c => `
      <div class="cliente-item ${clienteActivo?.id === c.id ? 'active' : ''}"
           onclick="seleccionarCliente('${c.id}')">
        ${consultasSinLeer.get(c.id) > 0 ? '<span class="cliente-dot-sinleer" title="Mensajes sin leer"></span>' : ''}
        <div class="cliente-name">${escHtml(c.razon_social) || '—'}</div>
        <div class="cliente-meta">
          <span>${formatCuit(c.cuit || '')}</span>
          <span class="badge ${c.tipo === 'ri' ? 'badge-ri' : 'badge-mono'}">
            ${c.tipo === 'ri' ? 'R.I.' : 'Mono'}
          </span>
        </div>
      </div>
    `).join('');
  }

  // Único lugar donde se aplican búsqueda + tipo + papelera — antes esta
  // misma lógica estaba duplicada acá y en seleccionarCliente(), ahora
  // las dos llaman a esto.
  // Escapa lo que se interpola en innerHTML y no lo escribió el estudio: la
  // razón social de un cliente que entró por el formulario público la carga un
  // desconocido. La Cloud Function ya limpia en la entrada; esto cubre además
  // lo guardado antes de esa limpieza.
  function escHtml(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => (
      { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
    ));
  }

  function clientesFiltrados() {
    const q = document.getElementById('search-input').value.toLowerCase();
    return clientes.filter(c => {
      // Un cliente que entró por el formulario público nace con activo:false
      // hasta que alguien lo confirma — pero eso NO es lo mismo que estar
      // archivado. Sin esta guardia se mezclaban en "Ver papelera" con los
      // que se archivaron a mano, que es otra cosa. Su lugar es el panel
      // "Clientes Pendientes"; acá no va en ninguna de las dos listas.
      if (c.estado === 'pendiente_confirmacion') return false;

      const archivado = c.activo === false;
      if (verPapelera !== archivado) return false; // papelera: solo archivados; normal: solo activos
      const coincideTipo = verPapelera || filtroActivo === 'todos' || c.tipo === filtroActivo;
      const coincideQ    = !q ||
        (c.razon_social || '').toLowerCase().includes(q) ||
        (c.cuit || '').includes(q);
      return coincideTipo && coincideQ;
    });
  }

  function filtrarClientes() {
    renderClientes(clientesFiltrados());
  }

  function setFiltro(btn) {
    document.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
