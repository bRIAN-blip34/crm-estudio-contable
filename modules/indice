      const chips = porTint[tint].map(btn => {
        const deshabilitado = btn.disabled;
        return '<span class="raillegend-chip">' + ((btn.querySelector('svg') || {}).outerHTML || '') + ' ' +
          btn.getAttribute('aria-label') + (deshabilitado ? ' · elegí un cliente' : '') + '</span>';
      }).join('');
      return '<div class="raillegend-group">' +
        '<span class="raillegend-swatch" style="background:var(--' + tint + ')"></span>' +
        '<div><div class="raillegend-name">' + meta.label + '</div>' +
        '<div class="raillegend-desc">' + meta.desc + '</div>' +
        '<div class="raillegend-chips">' + chips + '</div></div>' +
      '</div>';
    }).join('') || '<p style="color:var(--text-3);font-size:13px">No hay ningún grupo con color visible todavía.</p>';
    document.getElementById('raillegend-overlay').style.display = 'flex';
