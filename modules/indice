  // chips Todos/R.I./Mono se ocultan mientras está activa (ver
  // clientesFiltrados) — no tiene sentido cruzarlos con "archivado".
  function togglePapelera() {
    verPapelera = !verPapelera;
    document.getElementById('btn-papelera-label').textContent =
      verPapelera ? 'Volver a clientes activos' : 'Ver papelera';
    document.querySelector('.sidebar-filters').style.display = verPapelera ? 'none' : '';
    filtrarClientes();
