  function formatCuit(cuit) {
    const c = cuit.replace(/\D/g, '');
    if (c.length !== 11) return cuit;
    return `${c.slice(0,2)}-${c.slice(2,10)}-${c.slice(10)}`;
  }

  // Exponer globales necesarios para onclick y módulos
  window._toast           = toast;
