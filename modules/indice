  function inicialesEstudio(nombre) {
    return (nombre || '')
      .split(/\s+/)
      .filter(Boolean)
      .slice(0, 2)
      .map(w => w[0].toUpperCase())
      .join('') || 'FX';
  }

  // Co-branding del estudio (multi-tenant fase 2): lee /estudios/{id} y
  // pinta el nombre real en el topbar. Si el doc todavía no existe (primer
  // load después de este deploy) y quien entró es admin, lo crea con los
  // datos del único estudio que había hasta ahora y de paso backfillea
  // estudio_id en los clientes/crm_users viejos que no lo tenían — así no
  // hace falta migrar nada a mano, corre una sola vez.
  async function cargarEstudio() {
    try {
      const ref = window._doc(window._db, 'estudios', window._estudioId);
      let snap = await window._getDoc(ref);

      if (!snap.exists() && (miRol === 'admin' || miRol === 'super_admin')) {
        await window._setDoc(ref, {
          nombre:         'Insfran y Asociados',
          logo_url:       null,
          color_accent:   null,
          fecha_creacion: new Date().toISOString(),
        });
        await backfillEstudioId();
        snap = await window._getDoc(ref);
      }

      // Backfill aparte (independiente del de arriba, que solo corre si el
      // doc de /estudios/ no existía todavía). En producción resultó que
      // ESE backfill nunca llegó a correr — el doc de /estudios/insfran ya
      // existía desde antes de que este flujo se desplegara, así que la
      // condición `!snap.exists()` de arriba nunca dio true. Efecto real:
      // crm_users creados vía usuarios.js (que hasta este mismo deploy no
      // estampaba estudio_id al crear, ver CLAUDE.md "Multi-tenant")
      // quedaron sin el campo, y con el nuevo where('estudio_id',...) de
      // usuarios.js/cargarClientes() eso los hacía desaparecer de los
      // listados — "sin usuarios cargados" en el panel, con usuarios reales
      // adentro. Este backfill vuelve a correr backfillEstudioId() (clientes
      // + crm_users) con su propio flag, sin depender de si el de arriba
      // llegó a dispararse alguna vez. Corre una sola vez, la dispara el
      // primer admin/super_admin que entra después de este deploy.
      if (snap.exists() && (miRol === 'admin' || miRol === 'super_admin') &&
          !snap.data().clientes_crm_users_estudio_id_ok) {
        await backfillEstudioId();
        await window._setDoc(ref, { clientes_crm_users_estudio_id_ok: true }, { merge: true });
        snap = await window._getDoc(ref);
      }

      // Backfill de las 5 subcolecciones (honorarios/vencimientos/
      // liquidaciones/consultas/comprobantes) — necesario para el
      // aislamiento por estudio de las 5 reglas collectionGroup del panel
      // de administrador (ver firestore.rules, sección COLLECTION GROUP):
      // esas queries filtran con where('estudio_id', '==', ...), y un
      // where() de igualdad nunca matchea un campo ausente — sin este
      // backfill, cualquier honorario/vencimiento/liquidación/consulta/
      // comprobante cargado antes de ese fix desaparecería del panel.
      // Guardado con su propio flag. Corre una sola vez por estudio, la
      // dispara el primer admin/super_admin que entra después de ese
      // deploy.
      if (snap.exists() && (miRol === 'admin' || miRol === 'super_admin') &&
          !snap.data().subcolecciones_estudio_id_ok) {
        await backfillEstudioIdSubcolecciones();
        await window._setDoc(ref, { subcolecciones_estudio_id_ok: true }, { merge: true });
        snap = await window._getDoc(ref);
      }

      // Datos del estudio para el resto del CRM (prueba, comprobantes con su nombre).
      window._estudio = snap.exists() ? { ...snap.data(), id: snap.id } : null;
      const nombreEstudio = snap.exists() ? (snap.data().nombre || 'Finnix') : 'Finnix';
      const nameEl  = document.getElementById('topbar-studio-name');
      const badgeEl = document.getElementById('topbar-studio-badge');
      if (nameEl)  nameEl.textContent  = nombreEstudio;
      if (badgeEl) badgeEl.textContent = inicialesEstudio(nombreEstudio);
    } catch (e) {
      console.error('Error al cargar el estudio:', e);
    }
  }

  async function backfillEstudioId() {
    try {
      const [clientesSnap, usersSnap] = await Promise.all([
        window._getDocs(window._collection(window._db, 'clientes')),
        window._getDocs(window._collection(window._db, 'crm_users')),
      ]);
      const pendientes = [
        ...clientesSnap.docs
          .filter(d => !d.data().estudio_id)
          .map(d => window._setDoc(window._doc(window._db, 'clientes', d.id), { estudio_id: window._estudioId }, { merge: true })),
        ...usersSnap.docs
          .filter(d => !d.data().estudio_id)
          .map(d => window._setDoc(window._doc(window._db, 'crm_users', d.id), { estudio_id: window._estudioId }, { merge: true })),
      ];
      await Promise.all(pendientes);
    } catch (e) {
      console.error('Error al migrar estudio_id en datos existentes:', e);
    }
  }

  // Backfill de las 5 subcolecciones que ahora filtran por estudio_id en
  // dashboard-general.js (honorarios/vencimientos/liquidaciones/consultas/
  // comprobantes, ver CLAUDE.md "Multi-tenant" y firestore.rules). A
  // diferencia de backfillEstudioId() (clientes/crm_users, 2 queries
  // totales) esto es un query por cliente por subcolección — más caro,
  // pero corre UNA sola vez (guardado en /estudios/{id}.subcolecciones_
  // estudio_id_ok, ver cargarEstudio()), no en cada carga como el resto
  // del panel (ver CLAUDE.md "Rendimiento a escala").
  async function backfillEstudioIdSubcolecciones() {
    const SUBCOLS = ['honorarios', 'vencimientos', 'liquidaciones', 'consultas', 'comprobantes'];
    try {
      const clientesSnap = await window._getDocs(window._collection(window._db, 'clientes'));
      for (const clienteDoc of clientesSnap.docs) {
        const estudioIdCliente = clienteDoc.data().estudio_id || window._estudioId;
        for (const sub of SUBCOLS) {
          const subSnap = await window._getDocs(window._collection(window._db, 'clientes', clienteDoc.id, sub));
          const pendientes = subSnap.docs
            .filter(d => !d.data().estudio_id)
            .map(d => window._setDoc(window._doc(window._db, 'clientes', clienteDoc.id, sub, d.id), { estudio_id: estudioIdCliente }, { merge: true }));
          await Promise.all(pendientes);
        }
      }
    } catch (e) {
      console.error('Error al migrar estudio_id en subcolecciones existentes:', e);
    }
  }

