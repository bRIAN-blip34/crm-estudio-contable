  function abrirLeyendaRail() {
    if (!miRol) return;
    asegurarLeyendaDom();
    const box = document.getElementById('raillegend-list');
    const porTint = {};
    const orden   = [];
    document.querySelectorAll('#rail .rail-grupo').forEach(grupoEl => {
      const tint = tintDeGrupo(grupoEl);
      if (!tint || !RAIL_GRUPO_META[tint]) return;
      const botones = Array.from(grupoEl.querySelectorAll('.rail-item[aria-label]'))
        .filter(btn => getComputedStyle(btn).display !== 'none');
      if (!botones.length) return;
